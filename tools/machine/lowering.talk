-- Constructs the stdlib, the sketch and the corpus don't reach, so that
-- `bun run machine:check` lowers every instruction in machine.toml at least
-- once. Not normative (ADR 0028).

use map from list

on coverage door, k, row, packet
  set the (k) of door to "open"
  refresh and wait
  put [1, 2] into xs
  put ...xs before xs
  put map into mapper
  if row ends with "x" then say "ends"
  put {a: 1, b: 2} into m
  delete the a of m
  delete the (k) of m
  put "z" into item 2 of row delimited by ";"
  delete item 1 of row delimited by ";"
  put << 1 as 4 bits, 2 as 4 bits >> into b
  match packet
    when << hi: 4 bits, lo: 4 bits >> then say hi & lo
  end match
end coverage

on deleting m, k, x
  delete the b of the (k) of m
  delete the b of the a of m
  delete word 1 of line 5 of x
  delete item 1 of item 2 of x delimited by ";"
end deleting

on routing next, order
  send (next) with order to me
  send (next) with order to me and wait
  wait for all
    send (next) with order to me and wait
  end wait
end routing

-- A repeat that collects its results (ADR 0059).

on collectingAdults rows
  repeat for each r in rows collecting the name of r into names
    if the age of r < 18 then next repeat
  end repeat
  return names
end collectingAdults

-- `collecting` is in the FOLLOW set, so `item` here is a variable, not a chunk.
on collectingLetters item
  repeat for each c in item collecting c & "!" into shouted
  end repeat
  return shouted
end collectingLetters

on collectingSquares
  repeat for each [k, v] in [[1, 2], [3, 4]] collecting k * v into products
  end repeat
  repeat for each n in 1..10 collecting n * n into squares
  end repeat
  return [products, squares]
end collectingSquares

-- Every head takes the clause. A condition may read the list so far.
on collectingRolls
  repeat 3 times collecting random(6) into dice
  end repeat
  repeat while the length of picks < 3 collecting random(6) into picks
  end repeat
  repeat until the length of found = 2 collecting 5 kg into found
  end repeat
  repeat forever collecting the length of dice into lengths  -- a comment
    if the length of lengths > 4 then exit repeat
  end repeat
  return [dice, picks, found, lengths]
end collectingRolls

-- The loop that only a `repeat` can write: its body waits for each element.
on collectingForecasts cities
  repeat for each city in cities collecting it into reports
    ask weather to forecast city and wait
  end repeat
  return reports
end collectingForecasts

-- A Lambda's body ends at `into`, since it isn't an operator.
on collectingScalers
  repeat for each n in [1, 2, 3] collecting given x: x * n into fs
  end
  return fs
end collectingScalers
