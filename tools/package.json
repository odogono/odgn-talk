{
  "name": "@northtalk/spec-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run test && bun run spec:check && bun run grammar:check && bun run machine:check && bun run corpus:check && bun run syntax:check && bun run unicode:check && bun run lints:check && bun run stdlib-fuel:check && bun run envelope:check && bun run docs:check && bun run save-format:check && bun run go-license:check",
    "spec:gen": "bun spec/generate.ts",
    "spec:check": "bun spec/generate.ts --check",
    "grammar:check": "bun grammar/check.ts",
    "machine:check": "bun machine/check.ts",
    "corpus:check": "bun corpus/check.ts",
    "corpus:bless": "bun corpus/bless.ts",
    "unicode:generate": "bun unicode/generate.ts",
    "unicode:check": "bun unicode/generate.ts --check",
    "unicode:fetch": "bun unicode/generate.ts --fetch",
    "syntax:generate": "bun syntax/generate.ts",
    "syntax:check": "bun syntax/generate.ts --check",
    "typecheck": "tsc",
    "test": "bun test grammar/container-properties.test.ts grammar/function-contract.test.ts spec/commands.test.ts commits/ corpus/ docs/ issues/ costs/ go/ zig/ machine/rejected-sources.test.ts machine/result-target.test.ts envelope/",
    "go:generate": "bun go/generate.ts",
    "go:check": "bun go/generate.ts --check",
    "zig:generate": "bun zig/generate.ts",
    "zig:check": "bun zig/generate.ts --check",
    "commits:check": "bun commits/check.ts",
    "save-format:check": "sh ../impl/elixir/scripts/check-save-format.sh",
    "go-license:check": "sh ../impl/go/check-license.sh",
    "changelog": "bun commits/changelog.ts",
    "release-notes:ts": "bun commits/release-notes.ts ts",
    "release-notes:go": "bun commits/release-notes.ts go",
    "lints:generate": "bun lints/generate.ts",
    "lints:check": "bun lints/generate.ts --check",
    "stdlib-fuel:generate": "bun costs/stdlib-fuel.ts",
    "stdlib-fuel:check": "bun costs/stdlib-fuel.ts --check",
    "docs:check": "bun docs/check.ts",
    "issues:graph": "bun issues/update.ts",
    "envelope:generate": "bun envelope/generate.ts",
    "envelope:check": "bun envelope/generate.ts --check"
  },
  "devDependencies": {
    "ajv": "^8",
    "prettier": "^3.9.9"
  }
}
