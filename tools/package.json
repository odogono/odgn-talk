{
  "name": "@odgn/northtalk-spec-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bun run test && bun run spec:check && bun run grammar:check && bun run machine:check && bun run corpus:check && bun run syntax:check && bun run unicode:check && bun run lints:check",
    "spec:gen": "bun spec/generate.ts",
    "spec:check": "bun spec/generate.ts --check",
    "grammar:check": "bun grammar/check.ts",
    "machine:check": "bun machine/check.ts",
    "corpus:check": "bun corpus/check.ts",
    "corpus:bless": "bun corpus/bless.ts",
    "unicode:generate": "bun unicode/generate.ts",
    "unicode:check": "bun unicode/generate.ts --check",
    "syntax:generate": "bun syntax/generate.ts",
    "syntax:check": "bun syntax/generate.ts --check",
    "typecheck": "tsc",
    "test": "bun test spec/commands.test.ts commits/ corpus/ costs/ go/ machine/rejected-sources.test.ts",
    "go:generate": "bun go/generate.ts",
    "go:check": "bun go/generate.ts --check",
    "commits:check": "bun commits/check.ts",
    "changelog": "bun commits/changelog.ts",
    "lints:generate": "bun lints/generate.ts",
    "lints:check": "bun lints/generate.ts --check"
  },
  "devDependencies": {
    "ajv": "^8"
  }
}
