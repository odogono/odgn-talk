{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "northtalk-org",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // The Go module paths go to src/go-import.ts.
    "run_worker_first": ["/go", "/go/*"]
  },
  "routes": [{ "pattern": "northtalk.org", "custom_domain": true }]
}
