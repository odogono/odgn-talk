-- One number type: an exact decimal with 34 significant digits.
on main
  say 0.1 + 0.2
  say 2.50 * 3
  if 2.50 * 3 = 7.5 then say "7.50 equals 7.5"
  say 1 / 3
  say 2 ^ 100
  say 7 mod 3

  say round(2.5)
  say round(2.345, 2)
  say round(2.345, 2, "half even")
  say floor(-2.5) & " " & ceiling(-2.5) & " " & truncate(-2.5)
  say sqrt(2)
  say max([3, 9, 4]) & " " & min([3, 9, 4])

  try
    say 1 / 0
  catch {code: c}
    say "1 / 0 raised " & c
  end try
end main
