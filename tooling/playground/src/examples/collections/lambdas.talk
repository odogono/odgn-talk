use filter, map, reduce, sortBy, sum from list

-- `given x: …` makes a Function Value you can pass to another function.
on main
  put [5, 3, 8, 1, 9, 2] into numbers
  say "evens: " & filter(numbers, given n: n mod 2 = 0)
  say "doubled: " & map(numbers, given n: n * 2)
  say "total: " & reduce(numbers, given total, n: total + n, 0)
  say "sum: " & sum(numbers)

  put [{name: "Ann", score: 72}, {name: "Bo", score: 91}, {name: "Cy", score: 64}] into players
  put sortBy(players, given p: the score of p, "descending") into ranked
  say "winner: " & the name of item 1 of ranked
  say "names: " & map(ranked, given {name: n}: n)
end main
