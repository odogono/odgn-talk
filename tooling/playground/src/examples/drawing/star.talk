-- A polygon is one command however many corners it has: this star is
-- filled and outlined with mitred corners, and the wave beneath it is
-- one open polyline.
on star cx, cy, outer, inner
  put [] into points
  repeat for each i in 0..9
    put outer into r
    if i mod 2 = 1 then
      put inner into r
    end if
    put i * pi / 5 - pi / 2 into a
    put [...points, [cx + r * cos(a), cy + r * sin(a)]] into points
  end repeat
  ask canvas to polygon points
end star

on draw
  tell canvas
    background "#ffffff"
    fill "#f5c400"
    stroke "#7a5c00"
    strokeWidth 6
    strokeJoin "miter"
  end tell
  star 200, 170, 140, 60
  put [] into wave
  repeat for each x in 0..40
    put [...wave, [x * 10, 360 + 20 * sin(x / 3)]] into wave
  end repeat
  tell canvas
    noFill
    stroke "#235f75"
    strokeWidth 3
    polyline wave
  end tell
end draw
