-- `tell canvas` sends each line to the canvas Capability. See the Canvas tab.
on draw
  tell canvas
    background "#f5f0e8"
    noStroke
    fill "#235f75"
    rectangle 70, 70, 180, 180
    fill "#e0a458"
    ellipse 250, 250, 160, 160
    fill "#23313b"
    textSize 20
    text "Hello, NorthTalk", 70, 350
  end tell
end draw
