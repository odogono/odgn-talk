{
  "comments": {
    "lineComment": "--"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "<<",
      ">>"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "`",
      "close": "`",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "\"",
      "\""
    ],
    [
      "`",
      "`"
    ]
  ],
  "wordPattern": "[A-Za-z_][A-Za-z0-9_]*|[0-9]+(?:\\.[0-9]+)?",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:private\\s+)?(?:on|function)\\s|repeat\\b|try\\s*(?:--.*)?$|match\\s|else\\s*(?:--.*)?$|catch\\b|finally\\b|offer\\b|.*\\bthen\\s*(?:--.*)?$)",
    "decreaseIndentPattern": "^\\s*(?:end|else|catch|finally|offer)\\b"
  }
}
