{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "NorthTalk",
  "scopeName": "source.northtalk",
  "fileTypes": [
    "talk"
  ],
  "comment": "Generated by tooling/vscode/tools/grammar.ts; do not edit.",
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#raw-text"
        },
        {
          "include": "#interpolated-text"
        },
        {
          "include": "#quoted-text"
        },
        {
          "include": "#number"
        },
        {
          "include": "#declaration"
        },
        {
          "include": "#block-end"
        },
        {
          "include": "#use"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#builtins"
        },
        {
          "include": "#call"
        },
        {
          "include": "#name"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comment": {
      "name": "comment.line.double-dash.northtalk",
      "match": "--.*$"
    },
    "raw-text": {
      "name": "string.quoted.triple.northtalk",
      "begin": "(\"{3,})",
      "end": "(?<!\")(\\1)(?!\")",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.northtalk"
        }
      },
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.northtalk"
        }
      }
    },
    "interpolated-text": {
      "name": "string.interpolated.northtalk",
      "begin": "`",
      "end": "`",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.northtalk"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.northtalk"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.northtalk",
          "match": "\\\\(?:x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\\{[0-9A-Fa-f]+\\}|0(?![0-9])|[^0-9xu]|$)"
        },
        {
          "name": "invalid.illegal.escape.northtalk",
          "match": "\\\\.?"
        },
        {
          "name": "meta.embedded.line.northtalk",
          "contentName": "source.northtalk",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.embedded.begin.northtalk"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.embedded.end.northtalk"
            }
          },
          "patterns": [
            {
              "include": "#braces"
            },
            {
              "include": "#code"
            }
          ]
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.northtalk"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.braces.northtalk"
        }
      },
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "#code"
        }
      ]
    },
    "quoted-text": {
      "name": "string.quoted.double.northtalk",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.northtalk"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.northtalk"
        }
      }
    },
    "number": {
      "match": "(?<![A-Za-z0-9_])(0x[0-9A-Fa-f]+|[0-9]+(?:\\.[0-9]+)?)(?:[ \\t]*((?:1/)?(?:inches|months|month|weeks|years|days|degC|degF|inch|week|year|AUD|CAD|CHF|CNY|EUR|GBP|INR|JPY|SEK|USD|day|min|cm|ft|hr|kg|km|lb|mL|mg|mi|mm|ms|oz|yd|L|g|m|s)(?:\\^[1-9][0-9]*)?(?:[*/](?:inches|months|month|weeks|years|days|degC|degF|inch|week|year|AUD|CAD|CHF|CNY|EUR|GBP|INR|JPY|SEK|USD|day|min|cm|ft|hr|kg|km|lb|mL|mg|mi|mm|ms|oz|yd|L|g|m|s)(?:\\^[1-9][0-9]*)?)*))?(?![A-Za-z0-9_])",
      "captures": {
        "1": {
          "name": "constant.numeric.northtalk"
        },
        "2": {
          "name": "keyword.other.unit.northtalk"
        }
      }
    },
    "declaration": {
      "match": "(?<![A-Za-z0-9_])(?:(private)[ \\t]+)?(on|function)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "storage.modifier.northtalk"
        },
        "2": {
          "name": "storage.type.function.northtalk"
        },
        "3": {
          "name": "entity.name.function.northtalk"
        }
      }
    },
    "block-end": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_])(end)[ \\t]+(finally|repeat|return|after|catch|given|match|offer|throw|until|where|while|else|exit|pass|then|veto|wait|when|end|for|try|if|tell)(?![A-Za-z0-9_])",
          "captures": {
            "1": {
              "name": "keyword.control.northtalk"
            },
            "2": {
              "name": "keyword.control.northtalk"
            }
          }
        },
        {
          "match": "(?<![A-Za-z0-9_])(end)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)(?![A-Za-z0-9_])",
          "captures": {
            "1": {
              "name": "keyword.control.northtalk"
            },
            "2": {
              "name": "entity.name.function.northtalk"
            }
          }
        }
      ]
    },
    "use": {
      "begin": "^[ \\t]*(use)(?![A-Za-z0-9_])",
      "end": "$",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.import.northtalk"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "match": "(?<![A-Za-z0-9_])(from|as)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)(?![A-Za-z0-9_])",
          "captures": {
            "1": {
              "name": "keyword.other.import.northtalk"
            },
            "2": {
              "name": "entity.name.namespace.northtalk"
            }
          }
        },
        {
          "include": "#name"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "constant.language.northtalk",
          "match": "(?<![A-Za-z0-9_])(?:nothing|false|true|it|me)(?![A-Za-z0-9_])"
        },
        {
          "name": "keyword.control.northtalk",
          "match": "(?<![A-Za-z0-9_])(?:finally|repeat|return|after|catch|given|match|offer|throw|until|where|while|else|exit|pass|then|veto|wait|when|end|for|try|if)(?![A-Za-z0-9_])"
        },
        {
          "name": "keyword.operator.word.northtalk",
          "match": "(?<![A-Za-z0-9_])(?:contains|matches|begins|ends|and|div|mod|not|in|is|of|or)(?![A-Za-z0-9_])"
        },
        {
          "name": "storage.modifier.northtalk",
          "match": "(?<![A-Za-z0-9_])(?:constant|variable|private|script)(?![A-Za-z0-9_])"
        },
        {
          "name": "keyword.other.northtalk",
          "match": "(?<![A-Za-z0-9_])(?:collecting|delimited|ignoring|multiply|subtract|replace|before|delete|divide|times|case|each|from|into|send|tell|with|add|all|any|ask|can|let|put|say|set|the|as|be|by|to)(?![A-Za-z0-9_])"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.constant.northtalk",
          "match": "(?<![A-Za-z0-9_])(?:newline|quote|tab|pi)(?![A-Za-z0-9_])"
        },
        {
          "name": "support.function.builtin.northtalk",
          "match": "(?<![A-Za-z0-9_])(?:offerAvailable|fromCodePoint|functionArity|functionName|fromFloat32|fromFloat64|isoWeekYear|isDisposed|nanosecond|objectKind|rangeStart|codePoint|dayOfYear|toFloat32|toFloat64|toInstant|rangeEnd|truncate|ceiling|hasTime|isoWeek|toCivil|weekday|kindOf|minute|offset|second|atan2|floor|log10|lower|month|power|round|upper|acos|asin|atan|hour|sqrt|year|abs|cos|day|exp|max|min|sin|tan|ln)(?![A-Za-z0-9_])"
        }
      ]
    },
    "call": {
      "match": "([A-Za-z_][A-Za-z0-9_]*)(?=\\()",
      "captures": {
        "1": {
          "name": "entity.name.function.call.northtalk"
        }
      }
    },
    "name": {
      "name": "variable.other.northtalk",
      "match": "[A-Za-z_][A-Za-z0-9_]*"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "keyword.operator.possessive.northtalk",
          "match": "'s(?![A-Za-z0-9_])"
        },
        {
          "name": "keyword.operator.northtalk",
          "match": "\\.\\.\\.|\\.\\.|<>|<=|>=|<<|>>|[&=<>+\\-*/^]"
        },
        {
          "name": "punctuation.separator.northtalk",
          "match": "[,:]"
        },
        {
          "name": "punctuation.section.brackets.northtalk",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
