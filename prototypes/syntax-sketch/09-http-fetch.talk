-- 09: fetch data over HTTP and work on it.
-- The Host granted `http` (suspending, limited to api.example.com) and `log`.
-- Uses `ask X to …` for Capability calls. That spelling is still open (see 07).
--
-- GET https://api.example.com/stations/LHR/readings?day=2026-09-27 returns:
--   { "station": "LHR",
--     "readings": [
--       {"at": "2026-09-27T00:00:00Z", "temp_c": 11.2, "wind_kph": 14, "gust_kph": null},
--       {"at": "2026-09-27T01:00:00Z", "temp_c": 10.8, "wind_kph": 31, "gust_kph": 52},
--       … ],
--     "next": "https://api.example.com/stations/LHR/readings?day=2026-09-27&page=2" }

on report station, day
  put "https://api.example.com/stations/" & station & "/readings?day=" & day into url
  ask http to get url                            -- Suspension Point
  -- ALT: put http.get(url) into response
  -- ALT: get url from http                      -- HyperTalk's `get`, result in `it`

  -- The response is plain data (a map), not a Host Object:
  --   {status: 200, headers: {…}, body: <bytes>}
  let {status: code, body: raw} be it
  if code is not 200 then
    log "fetch failed: " & code
    return nothing
    -- ?? What about an http error, or the Capability being revoked? That's
    --    error-handling fog; this sketch only covers the status code.
  end if

  put raw as text as json into data
  -- ALT: put the json of (raw as text) into data
  -- ALT: put parse json (raw as text) into data
  -- ALT: ask http to get json url               -- the Capability does the decoding
  -- ?? `as json` looks like a conversion, but JSON is a format, not a value kind.
  --    ADR 0003 bans `as list`/`as object` that run text as code. JSON parsing
  --    isn't that, but maybe `as` should stay for value kinds only and JSON
  --    should be a stdlib function (`json of …`).
  -- ?? JSON to Script values: object → map, array → list, number → decimal
  --    (exact if it fits in 34 digits?), null → Nothing. Can a list hold Nothing?
  --    Here it has to: `"gust_kph": null`.

  -- Destructure the shape we expect. A missing key means no match, so this is
  -- also validation.
  match data
    when {station: s, readings: rs} where rs is a list then
      summarise s, rs
    else
      log "unexpected shape"
  end match
end report

on summarise station, readings
  -- turn raw JSON records into typed values
  put [] into clean
  repeat for each r in readings
    match r
      when {at: a, temp_c: t is a number, wind_kph: w is a number} then
        put {at: a as instant, temp: t, wind: w as km/hr} after clean
        -- `temp` stays a plain number: the core only has temperature
        -- DIFFERENCES as Units (issue #8). Absolute °C is a stdlib concern.
        -- ?? `put … after clean` appends to a list. Reads well, and it's the
        --    same word as the text chunk write (`put "!" after …`).
        -- ALT: add {…} to clean                    -- `add` is arithmetic
        -- ALT: append {…} to clean
      else
        log "skipping bad reading: " & r
    end match
  end repeat

  -- filter, map, reduce
  put every r in clean where the wind of r > 30 km/hr into windy
  -- ALT: put the items of clean where each's wind > 30 km/hr into windy
  -- ALT: put filter(clean, r => r's wind > 30 km/hr) into windy    -- [advanced]
  -- ?? Some kind of collection comprehension is needed, and `where` is already
  --    the Guard keyword. Using it here keeps one meaning: "only when this holds".

  put the temp of every r in clean into temps
  -- ALT: put every r's temp in clean into temps
  -- ?? `the temp of every r in clean` (a map over the list) is lovely to read,
  --    but it's a hard parse: is it `the temp of (every r in clean)`, and does
  --    that distribute over the list?

  put the average of temps into mean
  put the max of temps into warmest
  put round mean to 1 places into mean
  put sort clean by the wind of each descending into byWind
  -- ALT: sort clean descending by wind          -- command form, rewrites `clean`
  -- ?? `each` as an implicit name inside `by …`. HyperTalk readers will like it,
  --    but it's yet another implicit name, like `it`.

  let [top, ...others] be byWind
  put station & " on " & the date of the at of top & ":" & return into summary
  -- ?? `the date of the at of top`: key names that are also words (`at`, `date`)
  --    read terribly. `top's at` is no better. JSON keys like `wind-kph` or
  --    `"feels like"` would need `the "wind-kph" of r`.
  put "  mean " & mean & ", warmest " & warmest & return after summary
  put "  windiest " & the wind of top & " at " & the at of top & return after summary
  put "  " & the length of windy & " windy hours" after summary
  log summary
  return {station: station, mean: mean, windy: the length of windy}
end summarise

-- Paging: follow `next` until it's missing.
on allReadings station, day
  put "https://api.example.com/stations/" & station & "/readings?day=" & day into url
  put [] into all
  repeat while url is not nothing
    ask http to get url
    put it's body as text as json into page
    put the readings of page after all
    -- ?? `put list after list`: does it append one element (a nested list) or
    --    splice in each element? Needs two spellings.
    put the next of page into url                -- missing key → Nothing → loop ends
  end repeat
  return all
end allReadings

-- Several stations at once. One Run can only wait for one thing, so going
-- concurrent means one Run per station (ADR 0004):
script variable results = {}

on compare stations
  repeat for each s in stations
    send fetchOne with s to me
  end repeat
end compare

on fetchOne s, every time
  put report(s, "2026-09-27") into the (s) of results
  -- ?? Calling this Script's own Handler like a function. Its `ask` suspends
  --    THIS Run, so a Suspension Point sits behind a call that looks
  --    immediate. The loader can see it; can a reader?
  -- ?? A computed key: `the (s) of results` vs `results[s]`. There's no good
  --    English spelling for a key held in a variable.
  if the length of results = 3 then log "all in: " & results
  -- ?? Fine for a demo. A real "join" wants `send … and wait` to several
  --    targets, or Script-level bookkeeping like this. Worth a question in
  --    the stdlib/host fog.
end fetchOne
