  ],
  "steps": [
    { "clock": "2026-09-28T09:00:00Z",
      "deliver": { "to": "orders", "name": "order", "args": [{ "sku": "A1", "qty": 3 }] } },
    { "clock": "2026-09-28T09:00:00Z",
      "answer": { "call": "pricing/r1.c1", "value": { "$quantity": ["2.50", "GBP"] } } },
    { "clock": "2026-09-28T09:00:01Z" },
    { "clock": "2026-09-28T09:00:01Z",
      "deliver": { "to": "orders", "name": "order", "args": [{ "sku": "B2", "qty": "lots" }] } },
    { "clock": "2026-09-28T09:00:02Z",
      "deliver": { "to": "orders", "name": "spin" } }
