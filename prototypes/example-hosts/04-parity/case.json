{
  "//": "PROTOTYPE parity case. Format is a sketch; the Conformance Corpus format is still fog.",
  "versions": { "language": "1.0", "costModel": "1", "machine": "1" },
  "limits": { "fuelPerRun": 20000, "allocPerRun": 65536, "persistentState": 16384 },
