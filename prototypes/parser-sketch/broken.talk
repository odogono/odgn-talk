-- PROTOTYPE (throwaway, issue #38): deliberately broken lines.
-- Each `-- case:` is parsed on its own; `run.ts --broken` prints the first
-- syntax error under the line it's on. Line numbers count from the case.
-- case: a Container missing at the end of the line
on t
  put 5 into
end t
-- case: the same, with a trailing comment (where is "end of line"?)
on t
  put 5 into        -- the newline token sits after the comment
end t
-- case: an operator with no right operand
on t
  put 1 + into x
end t
-- case: a comparison with no right operand
on t
  if count > then say "x"
end t
-- case: `<<` in operator position (there are no shift operators)
on t
  put a << b into c
end t
-- case: `...` in operator position (longest match: never `..` then `.`)
on t
  put 1...3 into r
end t
-- case: keyword-shaped Command Call arguments
on t
  log error rest
end t
-- case: `ask` with no Operation name
on t
  ask http to
end t
-- case: a bare word in a Text Pattern that is neither a keyword nor a Capture
on t
  put <"a", bogus> into x
end t
-- case: a Capture with nothing to capture
on t
  put <"a", b: > into x
end t
-- case: unterminated text (reported at the opening quote)
on t
  put "abc into x
end t
-- case: a character the language doesn't use
on t
  put 5 # 3 into x
end t
-- case: `end` with the wrong Handler name
on greet
  say "hi"
end greeet
-- case: `end repeat` missing: the error is at the name after `end`, not at `end`
on t
  repeat for each x in xs
    say x
end t
-- case: an open list swallows the newline, so the error lands on the next line
on t
  put [1, 2,
  say x
end t
-- case: a trailing `and` continues the line, into `and wait`
on t
  send m to x and
  wait 1 s
end t
-- case: `line` as a variable, minus 1: the chunk reading wins
on t
  put 5 into line
  put line - 1 into x
end t
-- case: a chunk with no index
on t
  put item of x into y
end t
-- case: two Unit words
on t
  put 5 s s into x
end t
-- case: `where` starting a continuation line (08, before the ADR 0019 update)
on handle {type: "invoice", amount: a}
    where a > 1000
  say a
end handle
-- case: `else` on the line after a single-line `if` (06, before the update)
on keypress k
  if k is "escape" then close dialog
  else pass keypress
end keypress
-- case: a literal is not a Container
on t
  put "Z" into character 20 of "short"
end t
-- case: `send it`: the message name can't be a Reserved Word
on t
  send it to approvals
end t
-- case: `as` with no kind
on t
  put x as into y
end t
-- case: parses, but `n - 1` is a Command Call to a Handler `n` with argument -1
on t
  n - 1
end t
-- case: parses, but `a` is a variable here, so this is equality, not a kind test
on t
  if x is a then say "same as a"
end t
-- case: parses, but `( … )` splices the boolean expression `letter or digit`
on t
  put <one or more of (letter or digit)> into ident
end t
-- case: parses, but `send refund` sends a message called `refund`
on handle {type: "refund"} as refund
  send refund to approvals
end handle
-- case: parses, but `3..7 m/s` is `3..(7 m/s)`
on t
  put 3..7 m/s into comfortable
end t
-- case: #54: a removed Comprehension; `every` is now just a name
on t
  put every r in xs where r > 1 into big
end t
-- case: #54: a removed `sorted by`
on t
  put sortBy(xs, given r: r) sorted by r into ys
end t
-- case: #54: JS-style arrow Lambda
on t
  put filter(xs, (r) => r > 1) into big
end t
-- case: #54: a Lambda head with no `:` inside an argument list
on t
  put filter(xs, given r r > 1) into big
end t
-- case: #54: a block Lambda closed with `end` alone
on t
  put given r
    return r
  end into f
end t
-- case: #54: a block Lambda that is never closed
on t
  put given r
    return r
end t
-- case: #54: a Lambda as a variable name
on t
  put 1 into given
end t
-- case: #54: `and wait` inside an expression
on t
  put fn(x) and wait into y
end t
-- case: #54: calling a call's result
on t
  put times(3)(14) into y
end t
-- case: #54: an expression Lambda body can't hold a statement
on t
  put given url: ask http to get url and wait into fetch
end t
-- case: #54: parses: the body ends at the comma, so `2` is `map`'s third argument, not part of the body
on t
  put map(xs, given r: r * 2, 2) into ys
end t
-- case: #54: parses, but `b` is a second parameter, not the next argument
on t
  put reduce(xs, given a, b: a + b) into total
end t
-- case: #54: parses, but the body is `r > 1 and ok`, not `(given r: r > 1) and ok`
on t
  put given r: r > 1 and ok into f
end t
