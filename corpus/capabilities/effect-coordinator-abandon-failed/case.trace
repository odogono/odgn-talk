> stub resource.write value=nothing
> stub resource.open value=nothing
> stub resource.close error={}
> stub-effect s.r phase=begin status=ok
> stub-effect s.r phase=rollback status=ok
> deliver d1 to=s message=go
> pump clock=2026-10-02T00:00:00Z
effect s/r1.s1 grant=r phase=begin status=ok
call s/r1.c1 op=r.write args=[] result=nothing
call s/r1.c2 op=alias.open args=[] result=nothing
scope s/r1.c2 grant=alias name=file action=opened
call s/r1.c3 op=alias.close args=[] error={} automatic=yes
scope s/r1.c3 grant=alias name=file action=failed
effect-failure s/r1 grant=alias segment=s/r1.s1 phase=abandon status=unknown scope=file
effect s/r1.s1 grant=r phase=rollback status=ok
seg s/r1 start delivery=d1 handler=go clause=1 fuel=36 alloc=16 state=16 end=effect-failed
run s/r1 outcome=effect-failed delivery=d1 handler=go effect={grant: "alias", segment: "s/r1.s1", phase: "abandon", status: "unknown", scope: "file"} fuel=36 alloc=16
pumped state=idle fuel=36
> stub resource.write value=nothing
> stub-effect s.r phase=begin status=ok
> stub-effect s.r phase=commit status=ok
> deliver d2 to=s message=later
> pump clock=2026-10-02T00:00:00Z
effect s/r2.s1 grant=r phase=begin status=ok
call s/r2.c1 op=r.write args=[] result=nothing
effect s/r2.s1 grant=r phase=commit status=ok
seg s/r2 start delivery=d2 handler=later clause=1 fuel=23 alloc=8 state=16 end=return
run s/r2 outcome=completed delivery=d2 handler=later fuel=23 alloc=8
pumped state=idle fuel=23
