# The store Standard Capability (#226). First blessing approved by the maintainer on 2026-10-07; see docs/reviews/store-blessings.
# A read-only Grant never enlists. A second writable Store in one Segment is
# `segment participant conflict`, and a Limit Fault rolls the Store writes back.
> load s identity=678585f2c9979ca1f94f9ccf5121157110386df1d51ae9eb63164fe2f8cc5bbe
> stub store.get value=nothing
> stub-effect s.st phase=begin status=ok
> stub store.set value=nothing
> stub-effect s.st phase=commit status=ok
> deliver d1 to=s message=go
> pump clock=2026-10-07T12:00:00Z
call s/r1.c1 op=reader.get args=["k"] result=nothing
effect s/r1.s1 grant=st phase=begin status=ok
call s/r1.c2 op=st.set args=["k", 1] result=nothing
raise s/r1 code="segment participant conflict" at=s:17 pos=6:3
effect s/r1.s1 grant=st phase=commit status=ok
seg s/r1 start delivery=d1 handler=go clause=1 fuel=51 alloc=32 state=16 end=error
run s/r1 outcome=errored delivery=d1 handler=go error={code: "segment participant conflict", capability: "other", operation: "set", participant: "st", at: {unit: "s", handler: "go", line: 6, column: 3}} fuel=51 alloc=32
pumped state=idle fuel=51
> stub-effect s.st phase=begin status=ok
> stub store.set value=nothing
> stub-effect s.st phase=rollback status=ok
> deliver d2 to=s message=spin limits={fuelPerRun: 200}
> pump clock=2026-10-07T12:00:00Z
effect s/r2.s1 grant=st phase=begin status=ok
call s/r2.c1 op=st.set args=["k", 1] result=nothing
fault s/r2 limit=fuel at=s:32 pos=11:3 rollback=[count]
effect s/r2.s1 grant=st phase=rollback status=ok
seg s/r2 start delivery=d2 handler=spin clause=1 fuel=200 alloc=24 state=16 end=fault
run s/r2 outcome=limit-fault delivery=d2 handler=spin limit=fuel fuel=200 alloc=24
pumped state=idle fuel=200
> vars
vars s count=1
