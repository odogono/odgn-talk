# Standard clock.now reads the Pump Clock, with no Stub or Host clock.
# Library needs keep its Grant under GrantsAsUsed. A hidden save/restore
# between Pumps must preserve the next microsecond-accurate reading.
> add-library helper identity=23af228f805c2318e5bcc44516eaea1da6c8ea7cb3a3cf4a1f9e46a046813b47
> load s identity=d3d335602978e0e81646dad058fab83b0d872b453a0a80c0c9b4a550b9d617f8
> deliver d1 to=s message=go
> pump clock=2026-10-02T10:00:00.123456Z
call s/r1.c1 op=clock.now args=[] result=2026-10-02T10:00:00.123456Z
seg s/r1 start delivery=d1 handler=go clause=1 fuel=45 alloc=42 state=40 end=return
run s/r1 outcome=completed delivery=d1 handler=go fuel=45 alloc=42
pumped state=idle fuel=45
> deliver d2 to=s message=go
> pump clock=2026-10-02T10:00:00.123457Z
call s/r2.c1 op=clock.now args=[] result=2026-10-02T10:00:00.123457Z
seg s/r2 start delivery=d2 handler=go clause=1 fuel=45 alloc=42 state=64 end=return
run s/r2 outcome=completed delivery=d2 handler=go fuel=45 alloc=42
pumped state=idle fuel=45
> vars
vars s seen=[2026-10-02T10:00:00.123456Z, 2026-10-02T10:00:00.123457Z]
