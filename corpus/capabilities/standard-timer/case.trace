# The standard timer declarations forward scheduling and cancellation to
# the Host, including the caller's Script and Operation costs. A Stub
# supplies extra Fuel. The due timer's Delivery is an ordinary Host Input,
# not a Core-owned timer; the runner replays it explicitly.
> add-library helper identity=1987228d2e928a342d72e9e7324ae45a1d2aae109447ff9e4ee900e718543b6c
> load s identity=6714c7c4f9b60900d9dc3dbdc53f7b92f65e6f64e5ec39cbda52709b10d72f86
> stub timer.schedule charge=5
> deliver d1 to=s message=go args=[2026-10-02T10:00:02Z]
> pump clock=2026-10-02T10:00:00Z
call s/r1.c1 op=timer.schedule args=["wake", 2026-10-02T10:00:02Z, "tick", [9]] charged=5
call s/r1.c2 op=timer.cancel args=["unknown"]
seg s/r1 start delivery=d1 handler=go clause=1 fuel=70 alloc=43 state=16 end=return
run s/r1 outcome=completed delivery=d1 handler=go fuel=70 alloc=43
pumped state=idle fuel=70
> deliver d2 to=s message=tick args=[9]
> pump clock=2026-10-02T10:00:02Z
seg s/r2 start delivery=d2 handler=tick clause=1 fuel=16 alloc=24 state=40 end=return
run s/r2 outcome=completed delivery=d2 handler=tick fuel=16 alloc=24
pumped state=idle fuel=16
> vars
vars s seen=[9]
