> stub-effect s.db phase=begin status=ok
> stub sqlite.change error={code: "sqlite busy"}
> stub-effect s.db phase=commit status=ok
> deliver d1 to=s message=write
> pump clock=2026-10-09T12:00:00Z
effect s/r1.s1 grant=db phase=begin status=ok
call s/r1.c1 op=db.change args=["INSERT INTO t (n) VALUES (?)", [1], 0] error={code: "sqlite busy"}
raise s/r1 code="sqlite busy" at=s:8 pos=4:5
effect s/r1.s1 grant=db phase=commit status=ok
seg s/r1 start delivery=d1 handler=write clause=1 fuel=48 alloc=91 state=51 end=return
run s/r1 outcome=completed delivery=d1 handler=write fuel=48 alloc=91
pumped state=idle fuel=48
