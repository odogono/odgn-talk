# A Library omits both trailing Optional positions; later calls supply
# one and two. Explicit Nothing is distinct from an absent argument.
# Every call pays its declared cost, including a zero-argument tell.
> add-library helper identity=c039ac1b2f3ebcf9219142f2a7270160ce0c2826c6117bd98847c81fbdb32eb2
> load s identity=832d6b08bc822dc4848e15cfff66531ff5c71f29de8c31fa352a3ff30ded38a1
> stub api.count value=1
> stub api.count value=2
> stub api.count value=3
> stub api.note charge=5
> deliver d1 to=s message=go
> pump clock=2026-10-02T14:00:00Z
call s/r1.c1 op=api.count args=[1] result=1
call s/r1.c2 op=api.count args=[1, "zone"] result=2
call s/r1.c3 op=api.count args=[1, nothing, 3] result=3
call s/r1.c4 op=api.note args=[] charged=5
call s/r1.c5 op=api.note args=[nothing]
seg s/r1 start delivery=d1 handler=go clause=1 fuel=137 alloc=126 state=88 end=return
run s/r1 outcome=completed delivery=d1 handler=go fuel=137 alloc=126
pumped state=idle fuel=137
> vars
