# Unblessed: queued Host Function cancellation labels (#490); first blessing awaits human review.
# Named functions and Lambdas cancelled before dispatch keep fn, have no Run id,
# spend no Fuel or allocation, and never execute their bodies.
> load home identity=dea40665e5866e6f8e67c4ce41d226cccbc3a91decb3ce3a27a84f606efb6465
> request d1 to=home message=named
> pump clock=2026-09-30T09:00:00Z
seg home/r1 start delivery=d1 handler=named clause=1 fuel=10 alloc=32 state=8 end=return
run home/r1 outcome=completed delivery=d1 handler=named value=<function home:work> fuel=10 alloc=32
pumped state=idle fuel=10

> call-value d2 fn=<function home:work>
> cancel-delivery d2
> pump clock=2026-09-30T09:00:00Z
run outcome=cancelled delivery=d2 fn=<function home:work> fuel=0 alloc=0
pumped state=idle fuel=0

> request d3 to=home message=lambda
> pump clock=2026-09-30T09:00:00Z
seg home/r2 start delivery=d3 handler=lambda clause=1 fuel=10 alloc=32 state=8 end=return
run home/r2 outcome=completed delivery=d3 handler=lambda value=<function home:9:10> fuel=10 alloc=32
pumped state=idle fuel=10

> call-value d4 fn=<function home:9:10>
> cancel-delivery d4
> pump clock=2026-09-30T09:00:00Z
run outcome=cancelled delivery=d4 fn=<function home:9:10> fuel=0 alloc=0
pumped state=idle fuel=0

> vars
vars home called=false
