seg shop/r4 start delivery=d5 handler=pressed clause=1 fuel=22 alloc=152 state=1280 end=return
run shop/r4 outcome=completed delivery=d5 handler=pressed fuel=22 alloc=152
seg shop/r1 resume fuel=29 alloc=128 state=798 end=return
run shop/r1 outcome=completed delivery=d1 handler=buy fuel=102 alloc=226
seg shop/r2 resume fuel=29 alloc=132 state=314 end=return
run shop/r2 outcome=completed delivery=d2 handler=buy fuel=102 alloc=234
pumped state=idle fuel=144 next=2026-10-19T09:00:06Z

