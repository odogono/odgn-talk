# Unblessed: Library `wait for` observes the calling Run's Script (#1342); first blessing awaits human review.
# wait-for: two Runs of shop and one of other wait in dialogue's `confirm`.
# One "Y" to shop resumes both of shop's waits in the order they began and
# still reaches shop's own Handler; other's wait never sees it and times out.
# Then a wait in a Library that menu calls, a Script's waiting Lambda called
# from Library code, and a Library Join of two `ask` calls.

> add-library dialogue identity=1132aac00e53bbd6793c5884102b3131090f466ab1ef0fb727614652dfa28927
> add-library menu identity=cfa2f3b1832924727100540725fa5391eef718926389eac466b4dfff0eba683e
> load shop identity=91d1d047021360c81de1f1b96796e99c20eee8a6848360e20fc2bfaa2cc0c95d
> load other identity=8165ad58f13ede431d030180804e9f285f2d206d6af5f6595335c246d088f1b7
> deliver d1 to=shop message=buy args=["DART"]
> deliver d2 to=shop message=buy args=["SHIELD"]
> deliver d3 to=other message=buy args=["DART"]
> pump clock=2026-10-19T09:00:00Z
call shop/r1.c1 op=display.prompt args=["BUY DART?"]
seg shop/r1 start delivery=d1 handler=buy clause=1 fuel=39 alloc=49 state=515 end=ask-wait
call other/r1.c1 op=display.prompt args=["BUY DART?"]
seg other/r1 start delivery=d3 handler=buy clause=1 fuel=39 alloc=49 state=461 end=ask-wait
call shop/r2.c1 op=display.prompt args=["BUY SHIELD?"]
seg shop/r2 start delivery=d2 handler=buy clause=1 fuel=39 alloc=53 state=910 end=ask-wait
pumped state=idle fuel=117 next=2026-10-19T09:00:30Z
> answer shop/r1.c1 value=nothing
> answer shop/r2.c1 value=nothing
> answer other/r1.c1 value=nothing
> pump clock=2026-10-19T09:00:01Z
seg shop/r1 resume fuel=13 alloc=8 state=822 end=wait-for-any until=2026-10-19T09:00:06Z
seg other/r1 resume fuel=13 alloc=8 state=413 end=wait-for-any until=2026-10-19T09:00:06Z
seg shop/r2 resume fuel=13 alloc=8 state=814 end=wait-for-any until=2026-10-19T09:00:06Z
pumped state=idle fuel=39 next=2026-10-19T09:00:06Z

