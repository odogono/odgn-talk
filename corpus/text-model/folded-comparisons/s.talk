script variable log = []
on go
  put ["A" = "a" ignoring case, ["A"] = ["a"] ignoring case, "B" < "a" ignoring case] into log
  put ["A" <> "a" ignoring case, "B" > "a" ignoring case, "A" <= "a" ignoring case, "A" >= "a" ignoring case] after log
  put ["A" = "a", ["A"] = ["a"], "B" < "a"] after log
  put ["Σ" = "ς" ignoring case, "ẞ" = "ß" ignoring case, "ß" = "ss" ignoring case, "İ" = "i" ignoring case] after log
  put [{key: ["A", {inner: "Σ"}]} = {key: ["a", {inner: "ς"}]} ignoring case] after log
  put [[{key: "A"}, "B"] < [{key: "a"}, "c"] ignoring case, ["A"] < ["a", "b"] ignoring case] after log
  put [["A"] is in [["b"], ["a"]] ignoring case, ["A"] is not in [["a"]] ignoring case] after log
  put [<"A"> = <"a"> ignoring case, [1, "A"] = [1.0, "a"] ignoring case, "1" = 1 ignoring case] after log
  put [capture("A") = capture("a") ignoring case, capture("A") = capture("a")] after log
end go

function capture value
  return given x: value
end capture

on costs
  -- A folded first pair must not stop scanning the rest of this text.
  put "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" into upper
  put "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" into lower
  put [upper = lower ignoring case, upper < lower ignoring case, upper <> lower ignoring case] after log
  put [upper = "aaaaaaaaaaaaaaaaZaaaaaaaaaaaaaaa" ignoring case, upper > "aaaaaaaaaaaaaaaaZaaaaaaaaaaaaaaa" ignoring case] after log
  put [[upper, upper] = [lower, lower] ignoring case, [upper, "B"] < [lower, "c"] ignoring case] after log
  put [upper is in ["bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", lower] ignoring case] after log
  -- U+0345 folds from a combining mark to iota: count folded Characters.
  put "aͅaͅaͅaͅaͅaͅaͅaͅaͅaͅaͅaͅaͅaͅaͅaͅ" into combining
  put [combining = combining ignoring case, combining is in [combining] ignoring case] after log
  match lower ignoring case
    when "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" then put true after log
    else put false after log
  end match
end costs

on shared
  put "ABCDEFGHIJKLMNOP" into left
  put "abcdefghijklmnop" into right
  repeat 8 times
    put [left, left] into left
    put [right, right] into right
  end repeat
  put [left = right ignoring case, left <= right ignoring case, left is in [right] ignoring case] after log
end shared

on mapKeys
  -- Fold values, but preserve exact keys even when their foldings collide.
  put [{A: "X"} = {A: "x"} ignoring case, {A: "X"} = {A: "x"}] after log
  put [{A: "X"} = {a: "x"} ignoring case, {A: "X"} = {a: "x"}, {A: "X"} <> {a: "x"} ignoring case] after log
  put [{A: "X", a: "Y"} = {a: "y", A: "x"} ignoring case, {A: "X", a: "Y"} = {a: "y", A: "x"}] after log
  -- Values stay attached to their exact keys; also reach a second-entry mismatch.
  put [{A: "X", a: "Y"} = {A: "y", a: "x"} ignoring case, {A: "X", a: "Y"} = {A: "x", a: "z"} ignoring case] after log
  put [{A: "X", a: "Y"} = {A: "x"} ignoring case, {A: nothing} = {a: nothing} ignoring case, {A: nothing} = {} ignoring case] after log
  put [{box: [{inner: {A: "X", a: "Y"}}]} = {box: [{inner: {a: "y", A: "x"}}]} ignoring case, {box: [{inner: {A: "X", a: "Y"}}]} = {box: [{Inner: {a: "y", A: "x"}}]} ignoring case] after log
  -- All three sigma spellings fold together, but remain three distinct keys.
  put [{"Σ": "X", "σ": "Y", "ς": "Z"} = {"ς": "z", "Σ": "x", "σ": "y"} ignoring case, {"Σ": "X", "σ": "Y", "ς": "Z"} = {"Σ": "y", "σ": "x", "ς": "z"} ignoring case] after log
  -- The right key spells e + U+0301; both key Values are NFC é.
  put [{"é": "X"} = {"é": "x"} ignoring case, {"é": "X"} = {"é": "x"}] after log
  put [{A: "X"} is in [{a: "x"}, {A: "x"}] ignoring case, {A: "X"} is in [{a: "x"}] ignoring case, {A: "X"} is not in [{a: "x"}] ignoring case] after log
end mapKeys

on mapKeyEarly
  put "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" into upper
  put "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" into lower
  put {A: upper, keep: upper} into left
  put {a: lower, keep: lower} into right
  -- Missing first exact key: scanned = 1, compare costs 2 + ceil(1 / 16) = 3.
  put left = right ignoring case after log
end mapKeyEarly

on mapKeyLate
  put "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" into upper
  put "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" into lower
  put {keep: upper, A: upper} into left
  put {keep: lower, a: lower} into right
  -- Fold-equal value then missing key: scanned = 1 + 32 + 1 = 34; compare costs 5.
  put left = right ignoring case after log
end mapKeyLate
