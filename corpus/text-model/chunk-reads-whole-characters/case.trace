# chunk-reads-whole-characters: pins that `character` chunks, ranges of
# them, negative indexes, `the characters of`, `the length of` and the
# `character` element of a Text Pattern all count whole Characters, never
# code points (chapter 3, Text; chapter 4, Chunk kinds and Matching). The
# text is "a", the family U+1F469 U+200D U+1F469 U+200D U+1F467, "q" with
# U+0301, and "b": 4 Characters and 9 code points. Its Fuel, allocation and
# state figures are Cost Model 0's, as the TS Core blessed them.

> load chunks identity=ecb737b4736ccb02ecacb19919a8fa677c5790a520441d54d7343be87ae91cdf
> deliver d1 to=chunks message=go
> pump clock=2026-09-30T09:00:00Z
seg chunks/r1 start delivery=d1 handler=go clause=1 fuel=188 alloc=1928 state=300 end=return
run chunks/r1 outcome=completed delivery=d1 handler=go fuel=188 alloc=1928
pumped state=idle fuel=188

> vars
vars chunks size=4 points=9 second="👩‍👩‍👧" third="q́" middle="👩‍👩‍👧q́" nextToLast="q́" split=["a", "👩‍👩‍👧", "q́", "b"] oneCharacter=true matchCount=4
