# Unblessed: the multi-tenant Example Host's globex tenant (#143); first blessing awaits human review.
# tenants-globex: the globex tenant of the multi-tenant Go Example Host
# (impl/go/examples/tenants), recorded by `go run ./examples/tenants record`.
# The Host recorded the `stub` lines from what its Host functions did.
# Its Fuel, allocation and state figures are Cost Model 0's.

> load shop identity=1b256e1a1e3cfccf9024a6dc179ff0b6a276aa9c4d367c0ecf8ce8ce2269c853

# The same Script prices from globex's catalog binding.
> stub catalog.lookUp value=0.75 GBP
> stub mail.notify charge=50
> request d1 to=shop message=order args=[{sku: "C3", qty: 10, to: ["ops@globex.example"]}]
> pump clock=2026-10-10T09:00:00Z
call shop/r1.c1 op=catalog.lookUp args=["C3"] result=0.75 GBP
call shop/r1.c2 op=mail.notify args=[["ops@globex.example"], "order C3 x10: 7.50 GBP"] charged=50
seg shop/r1 start delivery=d1 handler=order clause=1 fuel=198 alloc=234 state=56 end=return
run shop/r1 outcome=completed delivery=d1 handler=order value=7.50 GBP fuel=198 alloc=234
pumped state=idle fuel=198

# Twenty recipients: `notify` Charges 1000 Fuel, which a free plan Run can't
# cover after what it has spent, so the Run has a Limit Fault at the call.
# Nothing is sent, and the order's Script Variable changes roll back.
> stub catalog.lookUp value=3.00 GBP
> stub mail.notify charge=1000
> request d2 to=shop message=order args=[{sku: "A1", qty: 1, to: ["staff1@globex.example", "staff2@globex.example", "staff3@globex.example", "staff4@globex.example", "staff5@globex.example", "staff6@globex.example", "staff7@globex.example", "staff8@globex.example", "staff9@globex.example", "staff10@globex.example", "staff11@globex.example", "staff12@globex.example", "staff13@globex.example", "staff14@globex.example", "staff15@globex.example", "staff16@globex.example", "staff17@globex.example", "staff18@globex.example", "staff19@globex.example", "staff20@globex.example"]}]
> pump clock=2026-10-10T09:00:01Z
call shop/r2.c1 op=catalog.lookUp args=["A1"] result=3.00 GBP
call shop/r2.c2 op=mail.notify args=[["staff1@globex.example", "staff2@globex.example", "staff3@globex.example", "staff4@globex.example", "staff5@globex.example", "staff6@globex.example", "staff7@globex.example", "staff8@globex.example", "staff9@globex.example", "staff10@globex.example", "staff11@globex.example", "staff12@globex.example", "staff13@globex.example", "staff14@globex.example", "staff15@globex.example", "staff16@globex.example", "staff17@globex.example", "staff18@globex.example", "staff19@globex.example", "staff20@globex.example"], "order A1 x1: 3.00 GBP"]
fault shop/r2 limit=fuel at=shop:69 pos=20:5 rollback=[revenue, orders]
seg shop/r2 start delivery=d2 handler=order clause=1 fuel=144 alloc=231 state=56 end=fault
run shop/r2 outcome=limit-fault delivery=d2 handler=order limit=fuel fuel=144 alloc=231
pumped state=idle fuel=144

# The plan lapses: the Host revokes globex's `mail` Grant.
> revoke shop grant=mail
> pump clock=2026-10-10T09:00:02Z
pumped state=idle fuel=0

# `notify` now raises `capability revoked`; the order still completes.
> stub catalog.lookUp value=3.00 GBP
> request d3 to=shop message=order args=[{sku: "A1", qty: 2, to: ["ops@globex.example"]}]
> pump clock=2026-10-10T09:10:02Z
call shop/r3.c1 op=catalog.lookUp args=["A1"] result=3.00 GBP
raise shop/r3 code="capability revoked" at=shop:69 pos=20:5
seg shop/r3 start delivery=d3 handler=order clause=1 fuel=135 alloc=273 state=98 end=return
run shop/r3 outcome=completed delivery=d3 handler=order value=6.00 GBP fuel=135 alloc=273
pumped state=idle fuel=135

# A Reload that still calls `mail` is refused: the revoked Grant is gone
# after a Reload.
> reload shop carry=yes source="-- shop-v2.talk: the Reload a tenant uploads. Ten or more of a line take" & newline & "-- 10% off. Script Variables carry over." & newline & newline & "script variable revenue = 0.00 GBP" & newline & "script variable orders = 0" & newline & "script variable problems = []" & newline & newline & "on order {sku: sku, qty: qty, to: recipients}" & newline & "  try" & newline & "    ask catalog to lookUp sku" & newline & "  catch {code: code}" & newline & "    put code after problems" & newline & "    return code" & newline & "  end try" & newline & "  put it * qty into total" & newline & "  if qty >= 10 then" & newline & "    put total * 0.9 into total" & newline & "  end if" & newline & "  add total to revenue" & newline & "  add 1 to orders" & newline & "  try" & newline & "    tell mail to notify recipients, " & quote & "order " & quote & " & sku & " & quote & " x" & quote & " & qty & " & quote & ": " & quote & " & total" & newline & "  catch {code: code}" & newline & "    put code after problems" & newline & "  end try" & newline & "  return total" & newline & "end order" & newline & newline & "on remind recipients, note" & newline & "  wait 10 min" & newline & "  tell mail to notify recipients, " & quote & "reminder: " & quote & " & note" & newline & "end remind" & newline identity=bc8f18804a362af4c966c47fc5c1764a33ec8f0c5b688ef5727eeff2c14395d2
diag shop code="unknown operation" pos=22:10
diag shop code="unknown operation" pos=31:8

# Code without `mail` reloads, and the revoked Grant is removed.
> reload shop carry=yes source="-- shop-quiet.talk: the Reload for a tenant whose mail Grant was revoked." & newline & "-- It only prices and counts orders. Script Variables carry over." & newline & newline & "script variable revenue = 0.00 GBP" & newline & "script variable orders = 0" & newline & "script variable problems = []" & newline & newline & "on order {sku: sku, qty: qty, to: recipients}" & newline & "  try" & newline & "    ask catalog to lookUp sku" & newline & "  catch {code: code}" & newline & "    put code after problems" & newline & "    return code" & newline & "  end try" & newline & "  put it * qty into total" & newline & "  add total to revenue" & newline & "  add 1 to orders" & newline & "  return total" & newline & "end order" & newline identity=204940edd449eea1a987166fabea6ea3e52b9539ab3e6472c246362b09baea46
stopped shop reason="reload"

# Orders keep working without mail.
> stub catalog.lookUp value=3.00 GBP
> request d4 to=shop message=order args=[{sku: "A1", qty: 1, to: ["ops@globex.example"]}]
> pump clock=2026-10-10T09:10:05Z
call shop/r4.c1 op=catalog.lookUp args=["A1"] result=3.00 GBP
seg shop/r4 start delivery=d4 handler=order clause=1 fuel=89 alloc=88 state=98 end=return
run shop/r4 outcome=completed delivery=d4 handler=order value=3.00 GBP fuel=89 alloc=88
pumped state=idle fuel=89

# The Host bills from the Script's lifetime counters, and the case ends by
# inspecting the Group.
> counters shop
counters shop fuel=566 alloc=826 runs=4 faults=1 state=98 mailbox=0
> vars
vars shop revenue=16.50 GBP orders=3 problems=["capability revoked"]
