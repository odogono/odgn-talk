# orders-pricing: a worked example of a Trace (spec chapter 11). The `>`
# lines are Host Inputs. An author writes those, leaving out the ids and the
# keys bless fills in, and bless writes everything else. Its Fuel,
# allocation and state figures are Cost Model 0's, as the TS Core blessed
# them.

> load orders identity=ea1f59ea5d6647aae205cc01d2a0a9d01992cce1933d36f8a2f4c0e634a16cf4
> load pricing identity=cafc5ede31402ce8339f1e4bc3c363812eaa20a81a5f3ddb7ded3c3cc274d673

# An order that crosses to the pricing Script and waits on a suspending call.
# Both waits run out at the default 30 s `MaxWait`, the next deadline.
> deliver d1 to=orders message=order args=[{sku: "A1", qty: 3}]
> pump clock=2026-09-28T09:00:00Z
send orders/r1.c1 to=pricing message=quote args=["A1", 3] wait=yes
seg orders/r1 start delivery=d1 handler=order clause=1 fuel=42 alloc=74 state=426 end=send-wait
call pricing/r1.c1 op=prices.lookup args=["A1"]
seg pricing/r1 start from=orders/r1.c1 handler=quote clause=1 fuel=115 alloc=0 state=290 end=ask-wait
pumped state=idle fuel=157 next=2026-09-28T09:00:30Z
> answer pricing/r1.c1 value=2.50 GBP
> pump clock=2026-09-28T09:00:00Z
seg pricing/r1 resume fuel=15 alloc=24 state=274 end=wait until=2026-09-28T09:00:01Z
pumped state=idle fuel=15 next=2026-09-28T09:00:01Z
> pump clock=2026-09-28T09:00:01Z
seg pricing/r1 resume fuel=8 alloc=24 state=0 end=return
run pricing/r1 outcome=completed handler=quote value=7.50 GBP fuel=138 alloc=48
call orders/r1.c2 op=log.write args=["total 7.50 GBP"]
seg orders/r1 resume fuel=50 alloc=54 state=24 end=return
run orders/r1 outcome=completed delivery=d1 handler=order fuel=92 alloc=128
pumped state=idle fuel=58

# The first clause's Guard fails on "lots", so the second clause runs.
> deliver d2 to=orders message=order args=[{sku: "B2", qty: "lots"}]
> pump clock=2026-09-28T09:00:01Z
call orders/r2.c1 op=log.write args=["bad qty for B2: lots"]
seg orders/r2 start delivery=d2 handler=order clause=2 fuel=80 alloc=106 state=24 end=return
run orders/r2 outcome=completed delivery=d2 handler=order fuel=80 alloc=106
pumped state=idle fuel=80

# Runs out of Fuel. The faulting instruction is pinned, and the Segment's
# `add 1 GBP to total` is rolled back. The faulting instruction's charge
# isn't made, so the Run's Fuel stops short of its 20000.
> deliver d3 to=orders message=spin
> pump clock=2026-09-28T09:00:02Z
fault orders/r3 limit=fuel at=orders:66 pos=22:5 rollback=[total]
seg orders/r3 start delivery=d3 handler=spin clause=1 fuel=19978 alloc=15924 state=24 end=fault
run orders/r3 outcome=limit-fault delivery=d3 handler=spin limit=fuel fuel=19978 alloc=15924
pumped state=idle fuel=19978

# The runner ends every case by inspecting the Group.
> vars
vars orders total=7.50 GBP
vars pricing
