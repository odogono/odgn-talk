-- s.talk: the element-host-failures case's Script.

script variable log = []

on go
  try
    put element "a" of thisPage after log
  catch e
    put e after log
  end try
  try
    put element 1 of thisPage after log
  catch e
    put e after log
  end try
  try
    put the number of elements of thisPage after log
  catch e
    put e after log
  end try
end go
