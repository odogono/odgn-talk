-- lamp.talk: the properties case's Script.

script variable log = []

on go
  put [the id of bulb, the state of bulb, the watts of bulb, the colour of bulb] after log
  set the state of bulb to "on"
  put the state of bulb after log
  try
    set the watts of bulb to 100
  catch e
    put e after log
  end try
  try
    set the state of bulb to 1
  catch e
    put e after log
  end try
  put isDisposed(bulb) after log
end go

on later
  put [isDisposed(bulb), the id of bulb] after log
  try
    put the state of bulb into s
  catch e
    put e after log
  end try
end later
