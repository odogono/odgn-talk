# Unblessed: Rewind (#433); first blessing awaits human review.
# effects: what a Rewind undoes and what it leaves done (ADR 0068). It lands
# at `open`, with a scope open and the Segment-bound participant enlisted:
# the scope is abandoned with its automatic `close`, and the participant rolls
# back, as at a Limit Fault. The fire-and-forget `write` is final, so the
# redispatched Run, s/r2, writes again.

> load s identity=4dea42b659cb985c64a910db3f08e16a85efdd5dbff65a02a87319d87ffa0808
> stub resource.open value=nothing
> stub resource.open value=nothing
> stub resource.close value=nothing
> stub resource.close value=nothing
> stub-effect s.r phase=begin status=ok
> stub-effect s.r phase=rollback status=ok
> stub-effect s.r phase=begin status=ok
> stub-effect s.r phase=commit status=ok
> deliver d1 to=s message=go
> pump clock=2026-10-01T09:00:00Z
call s/r1.c1 op=log.write args=[]
effect s/r1.s1 grant=r phase=begin status=ok
call s/r1.c2 op=r.open args=[] result=nothing
scope s/r1.c2 grant=r name=file action=opened
> rewind-run s/r1
call s/r1.c3 op=r.close args=[] result=nothing automatic=yes
scope s/r1.c3 grant=r name=file action=abandoned
effect s/r1.s1 grant=r phase=rollback status=ok
seg s/r1 start delivery=d1 handler=go clause=1 fuel=25 alloc=0 state=32 end=rewind
pumped state=rewound fuel=25
> pump clock=2026-10-01T09:00:01Z
call s/r2.c1 op=log.write args=[]
effect s/r2.s1 grant=r phase=begin status=ok
call s/r2.c2 op=r.open args=[] result=nothing
scope s/r2.c2 grant=r name=file action=opened
call s/r2.c3 op=r.close args=[] result=nothing
scope s/r2.c3 grant=r name=file action=closed
effect s/r2.s1 grant=r phase=commit status=ok
seg s/r2 start delivery=d1 handler=go clause=1 fuel=43 alloc=16 state=0 end=return
run s/r2 outcome=completed delivery=d1 handler=go fuel=43 alloc=16
pumped state=idle fuel=43
> vars
vars s
