# Unblessed: Rewind before an unparked Run resumes (#1476); first blessing awaits human review.
# The resource Grant makes the Script use Segment bases even though this
# Handler never enlists a participant. s/r2 parks with n=0. s/r1 then commits
# n=1 and unparks s/r2, but the Pump cap stops it before its body resumes.
# Rewinding s/r2 must preserve n=1, including after Save/Restore.

> load s identity=18eec0d1323a542c8b70734f29ec1ce787e90034e8e917029ff61988d5cd6729
> deliver d1 to=s message=tick
> deliver d2 to=s message=tick
> pump clock=2026-10-01T09:00:00Z
call s/r1.c1 op=api.later args=[]
seg s/r1 start delivery=d1 handler=tick clause=1 fuel=14 alloc=0 state=288 end=ask-wait
seg s/r2 start delivery=d2 handler=tick clause=1 fuel=4 alloc=0 state=448 end=park
pumped state=idle fuel=18 next=2026-10-01T09:00:30Z
> answer s/r1.c1 value=1
> pump clock=2026-10-01T09:00:01Z fuel-cap=15
seg s/r1 resume fuel=15 alloc=32 state=208 end=return
run s/r1 outcome=completed delivery=d1 handler=tick fuel=29 alloc=32
pumped state=sliced fuel=15
> vars
vars s n=1
> rewind-run s/r2
> pump clock=2026-10-01T09:00:02Z
pumped state=rewound fuel=0
> vars
vars s n=1
