# Unblessed: restore after a transitive Library replacement (#2348); first blessing awaits human review.
# Replacing a Library recompiles the Libraries that import it, so a save
# straight after restores in full. Replacing it again after the save still
# refuses the restore as `save mismatch` (#2341).
> :clock virtual 2026-09-30T10:00:00Z
> :library add base
| function f
|   return 1
| end f
| on greet n
|   say n
| end greet
> :library add wrapper
| use f, greet from base
| function g
|   return f()
| end g
> use g from wrapper
> :library replace base
| function f
|   return 2
| end f
| on greet n
|   say n
| end greet
> g()
2
> :save
saved default
> :restore
restored default
> g()
2
> :library replace base
| function f
|   return 3
| end f
| on greet n
|   say n
| end greet
> g()
3
> :restore
! save mismatch
