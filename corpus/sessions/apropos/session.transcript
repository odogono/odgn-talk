# `:apropos` lists current bindings, Built-ins even when shadowed, and the
# public exports of every registered Library, imported or not, with the
# targets `:describe` takes. It imports and executes nothing.
> :clock virtual 2026-09-30T10:00:00Z
> :library add geo
| --| Area of a square.
| function area r
|   return r * r
| end area
|
| function plain
|   return 1
| end plain
|
| --| Hidden.
| private function secret
|   return 2
| end secret
| --| Six.
| constant six = 6
| --| One.
| on ping x where x = 1
|   return 1
| end ping
| --| Other.
| on ping x
|   return 2
| end ping
> :apropos area
name {target: {library: "geo", name: "area", origin: "library"}, origin: "geo", available: false, import: "use area from geo"}
doc "Area of a square."
> :apropos secret
> :apropos PING
name {target: {library: "geo", name: "ping", origin: "library"}, origin: "geo", available: false, import: "use ping from geo"}
doc 1 "One."
doc 2 "Other."
