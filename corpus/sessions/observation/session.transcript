> :fuel send boom to session
[session/r10] ! error {code: "division by zero"} at session+4:2:12
[session/r11] caught division by zero
trace start {script: "session", run: "session/r11", selector: "error", args: [{code: "division by zero", at: {unit: "session+4", handler: "boom", line: 2, column: 12}}]}
trace end {script: "session", run: "session/r11", selector: "error", outcome: "completed", result: nothing}
fuel {entry: "entry6", fuel: 69, state: "complete", interrupted: false, runs: 0, queued: 0}
