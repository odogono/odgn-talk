-- v.talk: the min-max-values case's Script.

script variable seen = []

on values
  put [max(6, 3, 9), min(6, 3, 9), max(100, 1000 - 75 * 20)] into seen
end values

on lone
  put [max([6, 3, 9]), min(7), max(2 m, 150 cm), max("a", "b")] into seen
end lone

on equal
  put [max(1, 1.0), min(1.0, 1)] into seen
end equal

on lists
  put max([1, 2], [3]) into seen
end lists

on mixed
  put max(1, 2, "t", 4) into seen
end mixed

on empty
  put min([]) into seen
end empty
