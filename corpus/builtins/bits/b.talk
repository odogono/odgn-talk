-- b.talk: the bits case's Script.

script variable seen = []

on examples
  put [bitAnd(12, 10), bitOr(12, 10), bitXor(12, 10), bitNot(0, 8)] after seen
  put [bitShiftLeft(255, 4, 8), bitShiftRight(255, 64), bitRotateLeft(1, 1, 3), bitRotateRight(1, 1, 3)] after seen
  put [bitCount(255), bitTest(4, 2), bitTest(4, 1)] after seen
end examples

on edges
  put [bitNot(0, 64), bitNot(18446744073709551615, 64), bitCount(18446744073709551615), bitTest(9223372036854775808, 63)] after seen
  put [bitShiftLeft(1, 63), bitShiftLeft(0, 64), bitShiftLeft(18446744073709551615, 64, 64), bitShiftLeft(3, 63, 64)] after seen
  put [bitShiftLeft(5, 2, nothing), bitShiftRight(18446744073709551615, 60), bitShiftRight(0, 0)] after seen
  put [bitRotateLeft(1, 64, 64), bitRotateLeft(1, 67, 3), bitRotateRight(1, 0, 1), bitRotateLeft(9223372036854775808, 1, 64), bitRotateRight(1, 1, 64)] after seen
end edges

on pcg
  -- The state seed 0 gives, and its first output: 3894649422.
  put 1876011003808476466 into state
  put bitAnd(bitShiftRight(bitXor(bitShiftRight(state, 18), state), 27), 2^32 - 1) into x
  put [x, bitRotateRight(x, bitShiftRight(state, 59), 32)] after seen
end pcg

on domain
  try
    put bitAnd(18446744073709551616, 1) after seen
  catch e
    put e after seen
  end try
  try
    put bitOr(1, -1) after seen
  catch e
    put e after seen
  end try
  try
    put bitXor(1.5, 1) after seen
  catch e
    put e after seen
  end try
  try
    put bitNot(256, 8) after seen
  catch e
    put e after seen
  end try
  try
    put bitNot(0, 65) after seen
  catch e
    put e after seen
  end try
  try
    put bitShiftLeft(1, 65) after seen
  catch e
    put e after seen
  end try
  try
    put bitShiftLeft(1, 1, 0) after seen
  catch e
    put e after seen
  end try
  try
    put bitShiftRight(1, 65) after seen
  catch e
    put e after seen
  end try
  try
    put bitRotateLeft(8, 1, 3) after seen
  catch e
    put e after seen
  end try
  try
    put bitRotateRight(1, -1, 3) after seen
  catch e
    put e after seen
  end try
  try
    put bitCount(0.5) after seen
  catch e
    put e after seen
  end try
  try
    put bitTest(1, 64) after seen
  catch e
    put e after seen
  end try
end domain

on kinds
  try
    put bitAnd("1", 1) after seen
  catch e
    put e after seen
  end try
  try
    put bitNot(1, 8 m) after seen
  catch e
    put e after seen
  end try
  try
    put bitShiftLeft(1, 1, "8") after seen
  catch e
    put e after seen
  end try
  try
    put bitTest(nothing, 0) after seen
  catch e
    put e after seen
  end try
end kinds

on overflow
  put bitShiftLeft(1, 64) after seen
end overflow

on overflowHigh
  put bitShiftLeft(18446744073709551615, 1) after seen
end overflowHigh
