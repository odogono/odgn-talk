# withheld-library: pins that `withheld` sets up a mismatch without a
# `replace-library`.
#
# - The Group holds fmt, so the save's Group Fingerprint covers fmt's code
#   identity. The runner leaves fmt out of the Libraries it passes the
#   restore, so the Fingerprint it computes differs.
# - With `mismatch=variables-only` the restore is variables-only, not
#   refused. tally imports nothing, so it still loads. Its Run tally/r1,
#   suspended in its `wait`, is discarded, and `count` is kept.

> add-library fmt identity=9ab27bd63baf66a30ed5dc05752da3efc02e99533835e8a29fc770641b050033
> load tally identity=79b9c1a0407750ab09b0d644712816ffe13499d3b525e6c7a4ec3e526396d602

> deliver d1 to=tally message=bump
> pump clock=2026-09-30T10:00:00Z
seg tally/r1 start delivery=d1 handler=bump clause=1 fuel=25 alloc=16 state=216 end=wait until=2026-09-30T10:00:10Z
pumped state=idle fuel=25 next=2026-09-30T10:00:10Z

> save s1
> restore from=s1 mismatch=variables-only withheld=[fmt] fingerprint=67688f7d4a15a317c8900cba16299ad78692e4ac3305aaa39c3eb53e184fc484 mode=variables-only discarded=[tally/r1]

# The discarded Run's wait is gone, so the only deadline is tally/r2's.
> deliver d2 to=tally message=bump
> pump clock=2026-09-30T10:00:01Z
seg tally/r2 start delivery=d2 handler=bump clause=1 fuel=25 alloc=16 state=216 end=wait until=2026-09-30T10:00:11Z
pumped state=idle fuel=25 next=2026-09-30T10:00:11Z

> vars
vars tally count=2
