# unsettled-call-is-lost: pins what happens to a pending call left unsettled
# after a restore.
#
# - After the settlements are drained (step 2 of the first Pump), every call
#   still unsettled fails in its Script with `call lost`, in call id order,
#   before any timer fires at step 3.
# - So shop/r2.c1 is `call lost`, not `timeout`, although its maxPending
#   deadline (10:00:10) has also passed by the first Pump (10:00:20).
# - The order Runs become ready in is the order they run in: shop/r1 (its
#   settlement), shop/r2 (`call lost`), then shop/r3 (its overdue `wait`).
# `call lost` is raised at the `ask … and wait` (shop:5, pos 9:5), and is an
# ordinary error the Script catches.

> load shop identity=e6901fa17de3df611249514648f16b3b83aa46b6c95beadf433cfae7bbaa2ccb

# Two pending calls, each with a maxPending deadline of 10:00:10, and a Run
# in a 5 s `wait`.
> deliver d1 to=shop message=check args=["A1"]
> deliver d2 to=shop message=check args=["B2"]
> deliver d3 to=shop message=nap
> pump clock=2026-09-30T10:00:00Z
call shop/r1.c1 op=stock.check args=["A1"]
seg shop/r1 start delivery=d1 handler=check clause=1 fuel=115 alloc=0 state=412 end=ask-wait
call shop/r2.c1 op=stock.check args=["B2"]
seg shop/r2 start delivery=d2 handler=check clause=1 fuel=115 alloc=0 state=676 end=ask-wait
seg shop/r3 start delivery=d3 handler=nap clause=1 fuel=15 alloc=0 state=836 end=wait until=2026-09-30T10:00:05Z
pumped state=idle fuel=245 next=2026-09-30T10:00:05Z

> save s1
> restore from=s1 fingerprint=7cc41345b6ebcf7a8ea8cb7f4dc7b22c68ba027ef05b999c9d1ceefb561392e1 mode=full pending=[shop/r1.c1, shop/r2.c1]

# Only shop/r1.c1 is settled. Every deadline has passed by 10:00:20.
> settle shop/r1.c1 how=answer value=12
> pump clock=2026-09-30T10:00:20Z
seg shop/r1 resume fuel=21 alloc=156 state=548 end=return
run shop/r1 outcome=completed delivery=d1 handler=check fuel=136 alloc=156
raise shop/r2 code="call lost" at=shop:5 pos=9:5
seg shop/r2 resume fuel=27 alloc=158 state=365 end=return
run shop/r2 outcome=completed delivery=d2 handler=check fuel=142 alloc=158
seg shop/r3 resume fuel=18 alloc=150 state=252 end=return
run shop/r3 outcome=completed delivery=d3 handler=nap fuel=33 alloc=150
pumped state=idle fuel=66

> vars
vars shop results=[["A1", 12], ["B2", "call lost"], ["nap", "woke"]]
