> load a identity=2e846a60d846c2e631360076c41c9957ead7f09858f587cd8dd537473f09d95e
> load b identity=88e25eaadce64c8bad60ece5d30a1ac3eb93674bc2d6f8e8cd264069e516129a

> deliver d1 to=a message=go
> deliver d2 to=b message=go
