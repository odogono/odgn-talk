script variable seen = nothing
script variable stage = 0
on gather
  try
    seed
    wait for all
      ask api to fetch 1 and wait
      put it into seen
      ask api to fetch 2 and wait
    end wait
    return it
  catch e
    return e
  end try
end gather
on fault
  put 1 into stage
  ask api to fetch 3 and wait
  put 2 into stage
  ask api to fetch 4 and wait
  put 3 into stage
end fault
on cancel
  try
    ask api to fetch 5 and wait
  finally
    put 4 into stage
  end try
end cancel
on seed
  return 77
end seed
