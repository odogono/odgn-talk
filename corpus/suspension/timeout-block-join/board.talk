-- board.talk: the timeout-block-join case's Script.

script variable results = []

on gather keys
  try
    with timeout of 2 s
      wait for all
        repeat for each k in keys
          ask feed to fetch k and wait
          send price with k to shop and wait
        end repeat
      end wait
    end timeout
    put it after results
  catch e
    put e after results
  end try
end gather
