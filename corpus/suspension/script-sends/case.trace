> load b identity=7ca8d0dca0ca3988df8a8acd34568d66555878b8d3f5a5e3b61225fdd0d0f092
> deliver d1 to=a message=fire args=[1]
> deliver d2 to=a message=missing
> deliver d3 to=a message=wrong args=[42]
> deliver d4 to=a message=cut
> pump clock=2026-10-04T12:00:00Z
send a/r1 to=b message=note args=[1]
send a/r1 to=b message=note args=[2]
raise a/r1 code="mailbox full" at=a:14 pos=5:4
send a/r1 to=a message=self
