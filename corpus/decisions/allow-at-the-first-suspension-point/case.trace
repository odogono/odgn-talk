# allow-at-the-first-suspension-point: the Verdict is sealed at the end of
# the deciding Run's first Segment. The board doesn't veto, and suspends at
# `ask replay to record m and wait`, so the Decision is allowed in the Pump
# that drains it, while the Run is still suspended. The Run's `run end`
# comes a Pump later, when the Host answers. Then a plain `deliver` of the
# same message reaches `veto` with no open Verdict: the Run just ends, the
# Trace notes `no-verdict`, and there is no `decided` record.

> load board identity=914e21610fbf4dcc37ee9278da1b4d415b9751ec781f6e90c8bc3661eaddd041

# The seal is at the `ask-wait` Segment end, so `decided` follows that `seg`.
> decide d1 to=board message=beforeMove args=[{from: "a2", to: "a3"}]
> pump clock=2026-09-30T10:00:00Z
call board/r1.c1 op=replay.record args=[{from: "a2", to: "a3"}]
seg board/r1 start delivery=d1 handler=beforeMove clause=1 fuel=67 alloc=0 state=378 end=ask-wait
decided d1 verdict=allowed
pumped state=idle fuel=67 next=2026-09-30T10:00:30Z

# The allowed Run goes on after its seal, and ends later.
> answer board/r1.c1 value=1
> pump clock=2026-09-30T10:00:01Z
seg board/r1 resume fuel=15 alloc=32 state=24 end=return
run board/r1 outcome=completed delivery=d1 handler=beforeMove fuel=82 alloc=32
pumped state=idle fuel=15

# `pause` sets `frozen`. The next `beforeMove` is a plain Delivery, not a
# Decision, so its Run holds no open Verdict: the `veto` ends it as
# `completed`, the Core notes it, and nothing is decided.
> deliver d2 to=board message=pause
> deliver d3 to=board message=beforeMove args=[{from: "a3", to: "a4"}]
> pump clock=2026-09-30T10:00:02Z
seg board/r2 start delivery=d2 handler=pause clause=1 fuel=10 alloc=0 state=162 end=return
run board/r2 outcome=completed delivery=d2 handler=pause fuel=10 alloc=0
note board/r3 kind=no-verdict
seg board/r3 start delivery=d3 handler=beforeMove clause=1 fuel=9 alloc=0 state=24 end=veto value="The game is paused."
run board/r3 outcome=completed delivery=d3 handler=beforeMove fuel=9 alloc=0
pumped state=idle fuel=19

> vars
vars board frozen=true moves=1
