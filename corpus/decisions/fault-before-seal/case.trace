# fault-before-seal: a Fuel fault before veto rolls back the Segment and
# leaves the Decision undecided. A later plain Delivery runs the same veto
# and finally, completes with Nothing, and records no-verdict.

> load decider identity=81cde39d6b6e0c5146f5a0e5f8012122d1ea6150e0b006a69b03d56abb44f08e
> decide d1 to=decider message=move limits={fuelPerRun: 20}
> pump clock=2026-09-30T10:00:00Z
fault decider/r1 limit=fuel at=decider:16 pos=7:5 rollback=[checked]
seg decider/r1 start delivery=d1 handler=move clause=1 fuel=20 alloc=16 state=16 end=fault
run decider/r1 outcome=limit-fault delivery=d1 handler=move limit=fuel fuel=20 alloc=16
decided d1 verdict=undecided undecided=[{script: "decider", run: "decider/r1", outcome: "limit fault"}]
pumped state=idle fuel=20
> vars
vars decider checked=0
> deliver d2 to=decider message=move
> pump clock=2026-09-30T10:00:01Z
note decider/r2 kind=no-verdict
seg decider/r2 start delivery=d2 handler=move clause=1 fuel=29 alloc=32 state=16 end=veto value="blocked"
