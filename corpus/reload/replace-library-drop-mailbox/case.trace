# Unblessed: a Library replacement drops its importers' mailboxes (#1951); first blessing awaits human review.
# - The Fuel Slice preempts a/r1 so d2 is still in a's mailbox at the replacement.
# - a/r1 is discarded, and d2 is dropped, so its note never runs and got stays "" (a/r1 was preempted before its first put).

> add-library fmt identity=eb0f2f1ad6c8414dd65e942eceeead3731bdf92c9d400409880d836cbe08a9f1
> load a identity=8a18774efe6c46bc86757e272f3a774f19a79efe7f3fa51761e9aa79bbec4dd2

> deliver d1 to=a message=go
> deliver d2 to=a message=note args=["x"]
> pump clock=2026-10-28T10:00:00Z fuel-slice=50
preempt a/r1 start delivery=d1 handler=go clause=1 by=slice fuel=50 alloc=66
pumped state=sliced fuel=50

> replace-library fmt carry=yes source="function label x" & newline & "  return " & quote & "v2 " & quote & " & x" & newline & "end label" & newline identity=da44bf7e6f6d4b9ec0f710355a502481c5d565a30034dcc6b5789f67ec078691
stopped a reason="reload" discarded=[a/r1] dropped=[d2]

> pump clock=2026-10-28T10:00:01Z
pumped state=idle fuel=0

> vars
vars a got=""
