# Pump caps stop at catch tests, immediately before choice, and just after choice.
# Transfer is stopped at entry to the policy cleanup copy: ordinary cancellation abandons
# the current cleanup rather than restarting it, so its 5 is absent in transfer cleanup.
# Cancellation rolls back policy writes, then runs retained and active policy finally scopes once.
> load tests identity=9c0eb0f703dce70396983e4d8eb71b6d663fb46f6cd553ba83d7b7216d888d98
> deliver d1 to=tests message=go
> pump clock=2026-10-06T09:00:00Z fuel-cap=39
raise tests/r1 code="bad" at=tests:7 pos=5:3
preempt tests/r1 start delivery=d1 handler=go clause=1 by=cap fuel=39 alloc=48
pumped state=sliced fuel=39
> counters tests
counters tests fuel=39 alloc=48 runs=1 faults=0 state=1230 mailbox=0
> cancel-run tests/r1
> pump clock=2026-10-06T09:00:00Z
seg tests/r1 continue fuel=44 alloc=96 state=128 end=cancel
run tests/r1 outcome=cancelled delivery=d1 handler=go fuel=83 alloc=144
pumped state=idle fuel=44
> vars
vars tests order=[1, 2, 3, 4] mark=0
