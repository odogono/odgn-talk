# deep-values: `build` nests maps and lists 1000 deep. Equality, ordering
# and the `vars` display reach the innermost item, and the Script Variables
# survive save and restore in the restored replay. `roundTrip` sends a value
# nested 300 deep through the `json` Library, whose source recurses on
# nesting, so it runs under the conformance minimum call depth. A tighter
# Allocation Budget makes the same build a Limit Fault rather than a Host
# error (spec chapter 6, Limits).

> load deep identity=4e236526509fd21d879a6d15369989d4627ec787cec686e556a46bccafa648df
> deliver d1 to=deep message=build args=[1000]
> pump clock=2026-09-30T09:00:00Z
seg deep/r1 start delivery=d1 handler=build clause=1 fuel=30311 alloc=77182209 state=65120 end=return
run deep/r1 outcome=completed delivery=d1 handler=build fuel=30311 alloc=77182209
pumped state=idle fuel=30311
> deliver d2 to=deep message=check
> pump clock=2026-09-30T09:00:01Z
seg deep/r2 start delivery=d2 handler=check clause=1 fuel=246 alloc=130241 state=65104 end=return
run deep/r2 outcome=completed delivery=d2 handler=check fuel=246 alloc=130241
pumped state=idle fuel=246
> deliver d3 to=deep message=roundTrip args=[150]
> pump clock=2026-09-30T09:00:02Z
seg deep/r3 start delivery=d3 handler=roundTrip clause=1 fuel=451972 alloc=8266419 state=65152 end=return
run deep/r3 outcome=completed delivery=d3 handler=roundTrip fuel=451972 alloc=8266419
pumped state=idle fuel=451972
> deliver d4 to=deep message=build args=[1000] limits={allocPerRun: 100000}
> pump clock=2026-09-30T09:00:03Z
fault deep/r4 limit=alloc at=deep:17 pos=16:9
seg deep/r4 start delivery=d4 handler=build clause=1 fuel=1072 alloc=99332 state=65152 end=fault
run deep/r4 outcome=limit-fault delivery=d4 handler=build limit=alloc fuel=1072 alloc=99332
pumped state=idle fuel=1072

