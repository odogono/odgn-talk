# host-mailbox-depth: `sink` loads with a mailbox depth of 1, and the Host
# makes three calls between Pumps, in this order:
#
# - The Broadcast is accepted. Its recipients are known only when it is
#   drained, so it counts toward no mailbox at the call.
# - The first `deliver` is accepted as d1: the mailbox is empty, and no
#   Delivery is queued to `sink`.
# - The second `deliver` is refused with `mailbox full`: the Delivery already
#   queued to `sink` fills its depth. A refused input is written at the call,
#   with no delivery id, so its line moves ahead of the two queued ones.
#
# At the drain, the Broadcast's one recipient gets d2 and joins the mailbox,
# then d1 joins behind it, past the depth, since a Delivery accepted at the
# call is never refused later. `sink` handles both, in mailbox order.
# Fuel, allocation and state figures are Cost Model 0's.

> load sink identity=7af8d5b0ffa5bee6f2bb48c4c788e58a09d2c22b735f4c0f31ad25deed68f204

> deliver to=sink message=note args=[2]
refused code="mailbox full"
> broadcast b1 message=note args=[0] recipients=[sink:d2]
> deliver d1 to=sink message=note args=[1]
> pump clock=2026-09-30T09:00:00Z
seg sink/r1 start delivery=d2 broadcast=b1 handler=note clause=1 fuel=16 alloc=24 state=88 end=return
run sink/r1 outcome=completed delivery=d2 broadcast=b1 handler=note fuel=16 alloc=24
seg sink/r2 start delivery=d1 handler=note clause=1 fuel=16 alloc=24 state=64 end=return
run sink/r2 outcome=completed delivery=d1 handler=note fuel=16 alloc=24
pumped state=idle fuel=32

> vars
vars sink got=[0, 1]
