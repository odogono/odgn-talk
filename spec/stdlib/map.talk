-- The `map` Library. Chapter 7 says what each export does, and this source
-- does exactly that (ADR 0021). It is normative Spec text: its private
-- helpers, its Fuel and the order of its calls are fixed here.

--| The map with the entries of `a` and then of `b`, where `b`'s value wins for a key in both
function merge a, b
  needMap(a)
  needMap(b)
  put a into merged
  repeat for each k in the keys of b
    put the (k) of b into the (k) of merged
  end repeat
  return merged
end merge

--| `m` without the entries whose keys are in the list `keys`
function without m, keys
  needMap(m)
  needKeys(keys)
  put {} into kept
  repeat for each k in the keys of m
    if k is not in keys then put the (k) of m into the (k) of kept
  end repeat
  return kept
end without

--| `m` with only the entries whose keys are in the list `keys`, in `m`'s order
function pick m, keys
  needMap(m)
  needKeys(keys)
  put {} into picked
  repeat for each k in the keys of m
    if k is in keys then put the (k) of m into the (k) of picked
  end repeat
  return picked
end pick

--| The list of pairs `[key, value]` of `m`, in order
function entries m
  needMap(m)
  put [] into pairs
  repeat for each k in the keys of m
    put [k, the (k) of m] after pairs
  end repeat
  return pairs
end entries

--| The map with the entries of the list of pairs `pairs`, where a later pair wins for a repeated key
function fromEntries pairs
  needList(pairs)
  repeat for each pair in pairs
    needList(pair)
    if the length of pair <> 2 then outOfDomain("fromEntries", pair)
    needText(item 1 of pair)
  end repeat
  put {} into built
  repeat for each pair in pairs
    put item 2 of pair into the (item 1 of pair) of built
  end repeat
  return built
end fromEntries

--| `m` with each value replaced by what `f` gives for it, keys and order kept
function mapValues m, f
  needMap(m)
  needFunction(f)
  put {} into mapped
  repeat for each k in the keys of m
    put f(the (k) of m) into the (k) of mapped
  end repeat
  return mapped
end mapValues

--| The value the Value Path `path` locates inside `m`, or `default` if a key or position along it is missing or holds Nothing
function lookup m, path, default = nothing
  needList(path)
  repeat for each step in path
    if step is a number then needInteger(step)
    if step is not a number then needText(step)
  end repeat
  put m into v
  put [] into taken
  repeat for each step in path
    if v is nothing then return default
    if step is a text then
      if v is not a map then wrongKindAt("map", v, taken)
      put the (step) of v into v
    else
      if v is not a list then wrongKindAt("list", v, taken)
      put item step of v into v
    end if
    put step after taken
  end repeat
  if v is nothing then return default
  return v
end lookup

-- A list of texts, as `without` and `pick` take.
private function needKeys keys
  needList(keys)
  repeat for each k in keys
    needText(k)
  end repeat
end needKeys

-- `wrong kind` for the value `lookup` reached at the Value Path `path`.
private function wrongKindAt expected, v, path
  put kindOf(v) into got
  throw {code: "wrong kind", expected: expected, got: got, value: v, path: path}
end wrongKindAt

-- The helpers below are the same in every stdlib Library. They raise the
-- catalogue errors of chapter 6. The Core adds each one's `message` and
-- points its `at` at the Script's call (ADR 0037).

private function wrongKind expected, v
  put kindOf(v) into got
  throw {code: "wrong kind", expected: expected, got: got, value: v}
end wrongKind

private function outOfDomain fn, v
  throw {code: "out of domain", function: fn, value: v}
end outOfDomain

private function needText v
  if v is not a text then wrongKind("text", v)
end needText

private function needNumber v
  if v is not a number then wrongKind("number", v)
end needNumber

private function needInteger v
  if v is not a number then wrongKind("number", v)
  if v is not an integer then wrongKind("integer", v)
end needInteger

private function needList v
  if v is not a list then wrongKind("list", v)
end needList

private function needMap v
  if v is not a map then wrongKind("map", v)
end needMap

private function needFunction v
  if v is not a function then wrongKind("function", v)
end needFunction
