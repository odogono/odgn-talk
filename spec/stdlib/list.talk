-- The `list` Library. Chapter 7 says what each export does, and this source
-- does exactly that (ADR 0021). It is normative Spec text: its private
-- helpers, its Fuel and the order of its calls are fixed here.

-- Aggregates -----------------------------------------------------------------

--| The items of `xs` added with `+`, left to right, or 0 for an empty list
function sum xs
  needList(xs)
  if xs is empty then return 0
  put item 1 of xs into total
  repeat for each x in items 2..-1 of xs
    put total + x into total
  end repeat
  return total
end sum

--| The sum of `xs` divided by its length
function average xs
  needList(xs)
  if xs is empty then outOfDomain("average", xs)
  return sum(xs) / the length of xs
end average

-- Reshaping ------------------------------------------------------------------

--| The list of pairs `[x, y]` of items at the same position, as long as the shorter list
function zip xs, ys
  needList(xs)
  needList(ys)
  put [] into pairs
  repeat for each i in 1..(the length of xs)
    if i > the length of ys then exit repeat
    put [item i of xs, item i of ys] after pairs
  end repeat
  return pairs
end zip

--| `xs` without the items equal to an earlier item
function unique xs
  needList(xs)
  put [] into kept
  repeat for each x in xs
    if x is not in kept then put x after kept
  end repeat
  return kept
end unique

--| `xs` in reverse order
function reverse xs
  needList(xs)
  put [] into backwards
  put the length of xs into i
  repeat while i > 0
    put item i of xs after backwards
    subtract 1 from i
  end repeat
  return backwards
end reverse

--| `xs` with each item that is a list replaced by its items, one level deep
function flatten xs
  needList(xs)
  put [] into flat
  repeat for each x in xs
    if x is a list then
      put ...x after flat
    else
      put x after flat
    end if
  end repeat
  return flat
end flatten

-- Sorting --------------------------------------------------------------------

--| `xs` sorted by `<`, stably
function sort xs, direction = "ascending"
  needList(xs)
  needText(direction)
  put isDescending(direction, "sort") into down
  put [] into keyed
  repeat for each x in xs
    put [x, x] after keyed
  end repeat
  return secondOfEach(mergeByKey(keyed, down))
end sort

--| `xs` sorted by `<` on the value `key` gives for each item, stably
function sortBy xs, key, direction = "ascending"
  needList(xs)
  needFunction(key)
  needText(direction)
  put isDescending(direction, "sortBy") into down
  put [] into keyed
  repeat for each x in xs
    put [key(x), x] after keyed
  end repeat
  return secondOfEach(mergeByKey(keyed, down))
end sortBy

--| `xs` sorted by the two-argument comparator `compare`, stably
function sortWith xs, compare, direction = "ascending"
  needList(xs)
  needFunction(compare)
  needText(direction)
  put isDescending(direction, "sortWith") into down
  return mergeWith(xs, compare, down)
end sortWith

private function isDescending direction, fn
  if direction = "ascending" then return false
  if direction = "descending" then return true
  outOfDomain(fn, direction)
end isDescending

-- The merge sort of chapter 7, over [key, item] pairs compared by `<`.
private function mergeByKey keyed, down
  put the length of keyed into n
  if n < 2 then return keyed
  put n div 2 into half
  put mergeByKey(items 1..half of keyed, down) into left
  put mergeByKey(items (half + 1)..n of keyed, down) into right
  put [] into merged
  put 1 into i
  put 1 into j
  repeat while i <= the length of left and j <= the length of right
    put item i of left into l
    put item j of right into r
    if down then
      put item 1 of l < item 1 of r into rightFirst
    else
      put item 1 of r < item 1 of l into rightFirst
    end if
    if rightFirst then
      put r after merged
      add 1 to j
    else
      put l after merged
      add 1 to i
    end if
  end repeat
  put ...items i..-1 of left after merged
  put ...items j..-1 of right after merged
  return merged
end mergeByKey

-- The same merge sort, asking `compare(left, right)` for a number.
private function mergeWith xs, compare, down
  put the length of xs into n
  if n < 2 then return xs
  put n div 2 into half
  put mergeWith(items 1..half of xs, compare, down) into left
  put mergeWith(items (half + 1)..n of xs, compare, down) into right
  put [] into merged
  put 1 into i
  put 1 into j
  repeat while i <= the length of left and j <= the length of right
    put item i of left into l
    put item j of right into r
    put compare(l, r) into order
    needNumber(order)
    if down then
      put order < 0 into rightFirst
    else
      put order > 0 into rightFirst
    end if
    if rightFirst then
      put r after merged
      add 1 to j
    else
      put l after merged
      add 1 to i
    end if
  end repeat
  put ...items i..-1 of left after merged
  put ...items j..-1 of right after merged
  return merged
end mergeWith

private function secondOfEach keyed
  put [] into picked
  repeat for each pair in keyed
    put item 2 of pair after picked
  end repeat
  return picked
end secondOfEach

-- Calling a Function Value on each item --------------------------------------

--| The items of `xs` for which `keep` gives true, in order
function filter xs, keep
  needList(xs)
  needFunction(keep)
  put [] into kept
  repeat for each x in xs
    if keep(x) then put x after kept
  end repeat
  return kept
end filter

--| The list of what `f` gives for each item of `xs`, in order
function map xs, f
  needList(xs)
  needFunction(f)
  put [] into mapped
  repeat for each x in xs
    put f(x) after mapped
  end repeat
  return mapped
end map

--| `f(f(f(initial, x1), x2), …)` over the items of `xs`, or `initial` for an empty list
function reduce xs, f, initial
  needList(xs)
  needFunction(f)
  put initial into acc
  repeat for each x in xs
    put f(acc, x) into acc
  end repeat
  return acc
end reduce

--| A map from each text `key` gives to the list of items that gave it, keyed in first-seen order
function group xs, key
  needList(xs)
  needFunction(key)
  put {} into groups
  repeat for each x in xs
    put key(x) into k
    needText(k)
    if the (k) of groups is nothing then
      put [x] into the (k) of groups
    else
      put x after the (k) of groups
    end if
  end repeat
  return groups
end group

--| `[matching, rest]`: the items for which `keep` gives true and the others, each in order
function partition xs, keep
  needList(xs)
  needFunction(keep)
  put [] into matching
  put [] into others
  repeat for each x in xs
    if keep(x) then
      put x after matching
    else
      put x after others
    end if
  end repeat
  return [matching, others]
end partition

--| Whether `test` gives true for some item, stopping at the first that does
function any xs, test
  needList(xs)
  needFunction(test)
  repeat for each x in xs
    if test(x) then return true
  end repeat
  return false
end any

--| Whether `test` gives true for every item, stopping at the first that doesn't
function all xs, test
  needList(xs)
  needFunction(test)
  repeat for each x in xs
    if not test(x) then return false
  end repeat
  return true
end all

--| The first item for which `test` gives true, or Nothing
function find xs, test
  needList(xs)
  needFunction(test)
  repeat for each x in xs
    if test(x) then return x
  end repeat
  return nothing
end find

--| The position of the first item equal to `value`, or 0 if there is none
function indexOf xs, value
  needList(xs)
  put 1 into i
  repeat for each x in xs
    if x = value then return i
    add 1 to i
  end repeat
  return 0
end indexOf

-- The helpers below are the same in every stdlib Library. They raise the
-- catalogue errors of chapter 6. The Core adds each one's `message` and
-- points its `at` at the Script's call (ADR 0037).

private function wrongKind expected, v
  put kindOf(v) into got
  throw {code: "wrong kind", expected: expected, got: got, value: v}
end wrongKind

private function outOfDomain fn, v
  throw {code: "out of domain", function: fn, value: v}
end outOfDomain

private function needText v
  if v is not a text then wrongKind("text", v)
end needText

private function needNumber v
  if v is not a number then wrongKind("number", v)
end needNumber

private function needInteger v
  if v is not a number then wrongKind("number", v)
  if v is not an integer then wrongKind("integer", v)
end needInteger

private function needList v
  if v is not a list then wrongKind("list", v)
end needList

private function needMap v
  if v is not a map then wrongKind("map", v)
end needMap

private function needFunction v
  if v is not a function then wrongKind("function", v)
end needFunction
