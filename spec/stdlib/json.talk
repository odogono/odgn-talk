-- The `json` Library: the JSON mapping of chapter 7, which each Core's
-- Host-side codec follows too. This source is normative Spec text (ADR 0021).
--
-- Decoding reads the text's code points rather than its Characters, since a
-- combining mark after a quote would join it into one Character, and reports
-- positions in Characters, as chapter 7 says.

use join, repeated from text

-- Decoding -------------------------------------------------------------------

--| The value the JSON text `t` holds
function decodeJson t
  needText(t)
  put the code points of t into cps
  let [v, j] be readValue(cps, skipSpace(cps, 1), t)
  put skipSpace(cps, j) into j
  if j <= the length of cps then invalid(t, j)
  return v
end decodeJson

-- Each reader takes the code point to start at, and gives [value, where it ended + 1].
private function readValue cps, i, t
  if i > the length of cps then invalid(t, i)
  put item i of cps into c
  if c = "{" then return readObject(cps, i, t)
  if c = "[" then return readArray(cps, i, t)
  if c = quote then return readString(cps, i, t)
  if c = "-" or isDigit(c) then return readNumber(cps, i, t)
  if c = "t" then return [true, literalEnd(cps, i, "true", t)]
  if c = "f" then return [false, literalEnd(cps, i, "false", t)]
  if c = "n" then return [nothing, literalEnd(cps, i, "null", t)]
  invalid(t, i)
end readValue

private function readArray cps, i, t
  put the length of cps into n
  put [] into xs
  put skipSpace(cps, i + 1) into j
  if j <= n and item j of cps = "]" then return [xs, j + 1]
  repeat forever
    let [v, k] be readValue(cps, j, t)
    put v after xs
    put skipSpace(cps, k) into j
    if j > n then invalid(t, j)
    if item j of cps = "]" then return [xs, j + 1]
    if item j of cps <> "," then invalid(t, j)
    put skipSpace(cps, j + 1) into j
  end repeat
end readArray

private function readObject cps, i, t
  put the length of cps into n
  put {} into m
  put {} into seen
  put skipSpace(cps, i + 1) into j
  if j <= n and item j of cps = "}" then return [m, j + 1]
  repeat forever
    if j > n then invalid(t, j)
    if item j of cps <> quote then invalid(t, j)
    let [name, k] be readString(cps, j, t)
    if the (name) of seen is true then invalid(t, j)
    put true into the (name) of seen
    put skipSpace(cps, k) into j
    if j > n then invalid(t, j)
    if item j of cps <> ":" then invalid(t, j)
    let [v, k] be readValue(cps, skipSpace(cps, j + 1), t)
    put v into the (name) of m
    put skipSpace(cps, k) into j
    if j > n then invalid(t, j)
    if item j of cps = "}" then return [m, j + 1]
    if item j of cps <> "," then invalid(t, j)
    put skipSpace(cps, j + 1) into j
  end repeat
end readObject

private function readString cps, i, t
  put the length of cps into n
  put [] into parts
  put i + 1 into j
  repeat forever
    if j > n then invalid(t, j)
    put item j of cps into c
    if c = quote then return [join(parts), j + 1]
    if codePoint(c) < 0x20 then invalid(t, j)
    if c = "\" then
      if j = n then invalid(t, j + 1)
      put item (j + 1) of cps into e
      if e = quote or e = "\" or e = "/" then
        put e after parts
        add 2 to j
      else if e is in ["b", "f", "n", "r", "t"] then
        put fromCodePoint(item (offset(e, "bfnrt")) of [8, 12, 10, 13, 9]) after parts
        add 2 to j
      else if e = "u" then
        put hex4(cps, j + 2, t) into u
        if u >= 0xDC00 and u <= 0xDFFF then invalid(t, j)
        add 6 to j
        if u >= 0xD800 and u <= 0xDBFF then
          if j + 1 > n then invalid(t, j)
          if item j of cps <> "\" or item (j + 1) of cps <> "u" then invalid(t, j)
          put hex4(cps, j + 2, t) into low
          if low < 0xDC00 or low > 0xDFFF then invalid(t, j)
          put 0x10000 + (u - 0xD800) * 1024 + (low - 0xDC00) into u
          add 6 to j
        end if
        put fromCodePoint(u) after parts
      else
        invalid(t, j + 1)
      end if
    else
      put c after parts
      add 1 to j
    end if
  end repeat
end readString

-- The four hexadecimal digits starting at code point `i`, as a number.
private function hex4 cps, i, t
  put 0 into u
  repeat for each k in i..(i + 3)
    if k > the length of cps then invalid(t, k)
    put offset(lower(item k of cps), "0123456789abcdef") - 1 into d
    if d < 0 then invalid(t, k)
    put u * 16 + d into u
  end repeat
  return u
end hex4

private function literalEnd cps, i, lit, t
  put the code points of lit into want
  repeat for each k in 1..(the length of want)
    if i + k - 1 > the length of cps then invalid(t, i + k - 1)
    if item (i + k - 1) of cps <> item k of want then invalid(t, i + k - 1)
  end repeat
  return i + the length of want
end literalEnd

-- A number, read exactly. Its exponent is applied, and a positive exponent is
-- rescaled to 0, so `1e5` is 100000 and `2.50e1` is 25.0 (chapter 7).
private function readNumber cps, i, t
  put the length of cps into n
  put i into j
  put "" into sign
  if item j of cps = "-" then
    put "-" into sign
    add 1 to j
  end if
  if j > n then invalid(t, j)
  if not isDigit(item j of cps) then invalid(t, j)
  put "" into whole
  if item j of cps = "0" then
    put "0" into whole
    add 1 to j
  else
    repeat while j <= n and isDigit(item j of cps)
      put item j of cps after whole
      add 1 to j
    end repeat
  end if
  put "" into fraction
  if j <= n and item j of cps = "." then
    add 1 to j
    repeat while j <= n and isDigit(item j of cps)
      put item j of cps after fraction
      add 1 to j
    end repeat
    if fraction is empty then invalid(t, j)
  end if
  put "" into expSign
  put "" into expDigits
  if j <= n and (item j of cps = "e" or item j of cps = "E") then
    add 1 to j
    if j <= n and (item j of cps = "+" or item j of cps = "-") then
      put item j of cps into expSign
      add 1 to j
    end if
    repeat while j <= n and isDigit(item j of cps)
      put item j of cps after expDigits
      add 1 to j
    end repeat
    if expDigits is empty then invalid(t, j)
  end if
  return [exactNumber(sign, whole, fraction, expSign, expDigits, t, i), j]
end readNumber

private function exactNumber sign, whole, fraction, expSign, expDigits, t, start
  put whole & fraction into coefficient
  put "" into significant
  repeat for each k in 1..(the length of coefficient)
    if character k of coefficient <> "0" then
      put characters k..-1 of coefficient into significant
      exit repeat
    end if
  end repeat
  repeat while the length of expDigits > 1 and character 1 of expDigits = "0"
    put characters 2..-1 of expDigits into expDigits
  end repeat
  if the length of expDigits > 9 then
    if significant is empty and expSign <> "-" then return 0
    invalid(t, start)
  end if
  put 0 into e
  if expDigits is not empty then put expDigits as number into e
  if expSign = "-" then put -e into e
  put e - the length of fraction into q
  if significant is empty and q >= 0 then return 0
  if the length of significant > 34 then invalid(t, start)
  if q >= 0 then
    if the length of significant + q > 34 then invalid(t, start)
    return (sign & significant & repeated("0", q)) as number
  end if
  if -q > 6176 then invalid(t, start)
  put coefficient into c
  if the length of c <= -q then put repeated("0", -q - the length of c + 1) & c into c
  put the length of c + q into point
  return (sign & characters 1..point of c & "." & characters (point + 1)..-1 of c) as number
end exactNumber

private function skipSpace cps, i
  put i into j
  repeat while j <= the length of cps
    if codePoint(item j of cps) is not in [32, 9, 10, 13] then exit repeat
    add 1 to j
  end repeat
  return j
end skipSpace

private function isDigit c
  return c matches <digit>
end isDigit

-- `i` is a code point position. The error gives the Character it falls in.
private function invalid t, i
  put the length of t + 1 into at
  if i <= the length of the code points of t then put the length of (code points 1..i of t) into at
  throw {code: "can't decode", format: "json", offset: at}
end invalid

-- Encoding -------------------------------------------------------------------

--| The value `v` as compact JSON text
function encodeJson v
  return encodeValue(v, [])
end encodeJson

private function encodeValue v, path
  if v is nothing then return "null"
  if v is a boolean or v is a number then return v as text
  if v is a text then return encodeString(v)
  if v is a list then
    put [] into parts
    put 1 into k
    repeat for each x in v
      put encodeValue(x, [...path, k]) after parts
      add 1 to k
    end repeat
    return "[" & join(parts, ",") & "]"
  end if
  if v is a map then
    put [] into parts
    repeat for each k in the keys of v
      put encodeString(k) & ":" & encodeValue(the (k) of v, [...path, k]) after parts
    end repeat
    return "{" & join(parts, ",") & "}"
  end if
  put kindOf(v) into kind
  throw {code: "not encodable", kind: kind, path: path}
end encodeValue

private function encodeString s
  put [] into parts
  repeat for each c in the code points of s
    put codePoint(c) into cp
    if c = quote then
      put "\" & quote after parts
    else if c = "\" then
      put "\\" after parts
    else if cp is in [8, 9, 10, 12, 13] then
      put "\" & character (indexIn([8, 9, 10, 12, 13], cp)) of "btnfr" after parts
    else if cp < 0x20 then
      put "\u00" & character (cp div 16 + 1) of "0123456789abcdef" & character (cp mod 16 + 1) of "0123456789abcdef" after parts
    else
      put c after parts
    end if
  end repeat
  return quote & join(parts) & quote
end encodeString

private function indexIn xs, value
  put 1 into i
  repeat for each x in xs
    if x = value then return i
    add 1 to i
  end repeat
  return 0
end indexIn

-- The helpers below are the same in every stdlib Library. They raise the
-- catalogue errors of chapter 6. The Core adds each one's `message` and
-- points its `at` at the Script's call (ADR 0037).

private function wrongKind expected, v
  put kindOf(v) into got
  throw {code: "wrong kind", expected: expected, got: got, value: v}
end wrongKind

private function outOfDomain fn, v
  throw {code: "out of domain", function: fn, value: v}
end outOfDomain

private function needText v
  if v is not a text then wrongKind("text", v)
end needText

private function needNumber v
  if v is not a number then wrongKind("number", v)
end needNumber

private function needInteger v
  if v is not a number then wrongKind("number", v)
  if v is not an integer then wrongKind("integer", v)
end needInteger

private function needList v
  if v is not a list then wrongKind("list", v)
end needList

private function needMap v
  if v is not a map then wrongKind("map", v)
end needMap

private function needFunction v
  if v is not a function then wrongKind("function", v)
end needFunction

-- JSON Pointer -------------------------------------------------------------

--| The Value Path the JSON Pointer text `t` locates, with each array index as a 1-based position
function pointerPath t
  needText(t)
  put pointerTokens(t) into tokens
  if tokens is nothing then outOfDomain("pointerPath", t)
  put [] into path
  repeat for each token in tokens
    if isIndex(token) then
      put token as number + 1 after path
    else
      put token after path
    end if
  end repeat
  return path
end pointerPath

-- The reference tokens of the JSON Pointer text `t`, unescaped, or Nothing if
-- `t` isn't a JSON Pointer. It reads code points, as decoding does, so a
-- combining mark can't join a slash.
private function pointerTokens t
  put [] into tokens
  if t = "" then return tokens
  put the code points of t into cps
  if item 1 of cps <> "/" then return nothing
  put [] into token
  put 2 into i
  repeat while i <= the length of cps
    put item i of cps into c
    if c = "/" then
      put join(token) after tokens
      put [] into token
    else if c = "~" then
      add 1 to i
      put item i of cps into e
      if e = "0" then
        put "~" after token
      else if e = "1" then
        put "/" after token
      else
        return nothing
      end if
    else
      put c after token
    end if
    add 1 to i
  end repeat
  put join(token) after tokens
  return tokens
end pointerTokens

-- Whether a reference token is an array index: digits with no leading zero.
private function isIndex token
  if token = "" then return false
  put the code points of token into cps
  if the length of cps > 1 and item 1 of cps = "0" then return false
  repeat for each c in cps
    if not isDigit(c) then return false
  end repeat
  return true
end isIndex

-- JSON Patch (ADR 0137) ------------------------------------------------------

--| `doc` with the RFC 6902 JSON Patch `patch`, a list of operations, applied in order
function applyPatch doc, patch
  needList(patch)
  put 1 into n
  repeat for each operation in patch
    put patchOperation(doc, operation, n) into doc
    add 1 to n
  end repeat
  return doc
end applyPatch

-- `doc` with one operation applied. Each failure raises `can't patch`.
private function patchOperation doc, operation, n
  if operation is not a map then cantPatch(n, nothing, nothing, "invalid operation")
  put the op of operation into op
  put the path of operation into path
  if op is not in ["add", "remove", "replace", "move", "copy", "test"] then cantPatch(n, op, path, "invalid operation")
  if path is not a text then cantPatch(n, op, path, "invalid operation")
  put pointerTokens(path) into at
  if at is nothing then cantPatch(n, op, path, "invalid pointer")
  put nothing into v
  if op is in ["add", "replace", "test"] then
    if "value" is not in the keys of operation then cantPatch(n, op, path, "invalid operation")
    put the value of operation into v
  end if
  put op into edit
  if op is in ["move", "copy"] then
    put the from of operation into from
    if from is not a text then cantPatch(n, op, path, "invalid operation")
    put pointerTokens(from) into source
    if source is nothing then cantPatch(n, op, path, "invalid pointer")
    let [found, v] be valueAt(doc, source)
    if not found then cantPatch(n, op, path, "missing target")
    if op = "move" then
      if the length of source < the length of at and isPrefix(source, at) then cantPatch(n, op, path, "move into itself")
      let [ok, doc] be editAt(doc, source, 1, "remove", nothing)
    end if
    put "add" into edit
  end if
  if op = "test" then
    let [found, current] be valueAt(doc, at)
    if not found or current <> v then cantPatch(n, op, path, "test failed")
    return doc
  end if
  let [ok, edited] be editAt(doc, at, 1, edit, v)
  if not ok then cantPatch(n, op, path, "missing target")
  return edited
end patchOperation

-- [ok, `c` with `edit` ("add", "remove" or "replace") of `v` made at tokens
-- `i` onward of `tokens`], as RFC 6902 makes it; ok is false when a target or
-- parent it needs is missing.
private function editAt c, tokens, i, edit, v
  if i > the length of tokens then
    if edit = "remove" then return [false, c]
    return [true, v]
  end if
  put item i of tokens into token
  if i < the length of tokens then
    let [found, child] be childOf(c, token)
    if not found then return [false, c]
    let [ok, child] be editAt(child, tokens, i + 1, edit, v)
    if not ok then return [false, c]
    if c is a map then
      put child into the (token) of c
    else
      put child into item (token as number + 1) of c
    end if
    return [true, c]
  end if
  if c is a map then
    put token is in the keys of c into present
    if edit = "add" then
      put v into the (token) of c
    else if not present then
      return [false, c]
    else if edit = "remove" then
      delete the (token) of c
    else
      put v into the (token) of c
    end if
    return [true, c]
  end if
  if c is not a list then return [false, c]
  if edit = "add" then
    if token = "-" then return [true, insertItem(c, the length of c + 1, v)]
    if not isIndex(token) then return [false, c]
    if token as number > the length of c then return [false, c]
    return [true, insertItem(c, token as number + 1, v)]
  end if
  if not isIndex(token) then return [false, c]
  if token as number >= the length of c then return [false, c]
  if edit = "remove" then
    delete item (token as number + 1) of c
  else
    put v into item (token as number + 1) of c
  end if
  return [true, c]
end editAt

-- [found, the value at `tokens` inside `v`].
private function valueAt v, tokens
  repeat for each token in tokens
    let [found, v] be childOf(v, token)
    if not found then return [false, nothing]
  end repeat
  return [true, v]
end valueAt

-- [found, the value under `token` in `c`], where a map key may hold Nothing.
private function childOf c, token
  if c is a map then return [token is in the keys of c, the (token) of c]
  if c is not a list then return [false, nothing]
  if not isIndex(token) then return [false, nothing]
  if token as number >= the length of c then return [false, nothing]
  return [true, item (token as number + 1) of c]
end childOf

-- `xs` with `v` inserted at position `p`, from 1 to one past its end.
private function insertItem xs, p, v
  put [] into out
  put 1 into k
  repeat for each x in xs
    if k = p then put v after out
    put x after out
    add 1 to k
  end repeat
  if p > the length of xs then put v after out
  return out
end insertItem

-- Whether the tokens `a` begin the tokens `b`.
private function isPrefix a, b
  if the length of a > the length of b then return false
  repeat for each k in 1..(the length of a)
    if item k of a <> item k of b then return false
  end repeat
  return true
end isPrefix

private function cantPatch n, op, path, reason
  throw {code: "can't patch", index: n, op: op, path: path, reason: reason}
end cantPatch
