{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/odogono/odgn-talk/spec/data/schema/units.schema.json",
  "title": "units",
  "description": "The Unit Catalogue.",
  "type": "object",
  "properties": {
    "kind": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "base": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": "string",
            "pattern": "^[A-Za-z]+(\\^[1-9][0-9]*)?(\\*[A-Za-z]+(\\^[1-9][0-9]*)?)*$"
          },
          "factor": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          },
          "calendar": {
            "const": true
          }
        },
        "required": [
          "name",
          "base"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "dimension"
            ]
          },
          {
            "required": [
              "calendar"
            ]
          }
        ]
      }
    },
    "unit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z]+$"
          },
          "plural": {
            "type": "string",
            "pattern": "^[A-Za-z]+$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "factor": {
            "type": "string",
            "pattern": "^[0-9]+(\\.[0-9]+)?$"
          },
          "ratio": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "name",
          "kind"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "factor"
            ]
          },
          {
            "required": [
              "ratio"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "kind",
    "unit"
  ],
  "additionalProperties": false
}
