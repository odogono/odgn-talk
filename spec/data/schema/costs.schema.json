{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/odogono/odgn-talk/spec/data/schema/costs.schema.json",
  "title": "costs",
  "description": "The Cost Model.",
  "type": "object",
  "$defs": {
    "formula": { "type": "string", "pattern": "^[0-9a-z()*/+ ]+$" }
  },
  "properties": {
    "version": { "type": "integer", "minimum": 0 },
    "measure": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "subject": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "size": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "of": { "type": "string", "minLength": 1 },
          "size": { "$ref": "#/$defs/formula" }
        },
        "required": ["of", "size"],
        "additionalProperties": false
      }
    },
    "rate": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z]+(-[a-z]+)*(\\.[a-zA-Z0-9]+)?$" },
          "fuel": { "$ref": "#/$defs/formula" },
          "alloc": { "$ref": "#/$defs/formula" },
          "input": { "type": "string", "minLength": 1 }
        },
        "required": ["key", "fuel"],
        "additionalProperties": false
      }
    },
    "change": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue": { "type": "string", "pattern": "^#[0-9]+$" },
          "change": { "type": "string", "minLength": 1 }
        },
        "required": ["issue", "change"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "measure", "subject", "size", "rate"],
  "additionalProperties": false
}
