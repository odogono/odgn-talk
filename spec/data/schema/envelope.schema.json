{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/odogono/odgn-talk/spec/data/schema/envelope.schema.json",
  "title": "envelope",
  "type": "object",
  "properties": {
    "features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]+(-[a-z]+)*-v[0-9]+$"
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/messageEntry"
      }
    },
    "reports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "settlement": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      },
      "required": [
        "fields"
      ],
      "additionalProperties": false
    },
    "intentional_kinds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kinds": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": [
                "uint",
                "int",
                "bool",
                "instant",
                "text",
                "texts",
                "value",
                "values",
                "target",
                "message",
                "limits",
                "err",
                "settlements",
                "reports",
                "record",
                "views",
                "pairs"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "kinds",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "json_messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "host-to-guest",
              "guest-to-host"
            ]
          },
          "reply": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/field"
            }
          }
        },
        "required": [
          "name",
          "direction",
          "fields"
        ],
        "additionalProperties": false
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z]+(-[a-z]+)*$"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/field"
            }
          }
        },
        "required": [
          "name",
          "fields"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "features",
    "messages",
    "reports",
    "settlement",
    "intentional_kinds",
    "json_messages",
    "views"
  ],
  "additionalProperties": false,
  "$defs": {
    "field": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
        },
        "kind": {
          "enum": [
            "uint",
            "int",
            "bool",
            "instant",
            "text",
            "texts",
            "value",
            "values",
            "target",
            "message",
            "limits",
            "err",
            "settlements",
            "reports",
            "record",
            "views",
            "pairs"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "host": {
          "type": "boolean",
          "description": "false when the Host fills the field itself rather than from a public option"
        },
        "view": {
          "type": "string",
          "minLength": 1,
          "description": "the view each item of a views field follows"
        }
      },
      "required": [
        "name",
        "kind",
        "required"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "views"
              }
            }
          },
          "then": {
            "required": [
              "view"
            ]
          },
          "else": {
            "not": {
              "required": [
                "view"
              ]
            }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "host-to-guest",
            "guest-to-host"
          ]
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      },
      "required": [
        "tag",
        "name",
        "direction",
        "fields"
      ],
      "additionalProperties": false
    },
    "messageEntry": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "host-to-guest",
            "guest-to-host"
          ]
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "layouts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "fields",
              "json"
            ]
          }
        }
      },
      "required": [
        "tag",
        "name",
        "direction",
        "fields",
        "layouts"
      ],
      "additionalProperties": false
    }
  }
}
