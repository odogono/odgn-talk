-- The browser's side of the chat: it reaches the server's "chat" exposure,
-- and hands it an unnamed exposure of its own to push lines to.
script variable server = nothing
script variable myNick = ""

on start nick
  put nick into myNick
  ask peer to reach "chat" into server and wait
  ask peer to expose into inbox and wait
  send join with "#talk", nick, inbox to server and wait
end start

--| Says a line the server pushed, after its sender's nick
--|
--| > :mock peer.reach suspending
--| > :mock peer.expose suspending
--| > send said with "#talk", "ann", "hello" to page and wait
--| [page/r1] ann: hello
on said channel, nick, line
  say nick & ": " & line
end said

on type line
  send speak with "#talk", myNick, line to server
end type
