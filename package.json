{
  "name": "odgn-talk-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "impl/ts",
    "tooling/*",
    "tools"
  ],
  "scripts": {
    "check": "bun run --cwd tools check",
    "spec:gen": "bun run --cwd tools spec:gen",
    "spec:check": "bun run --cwd tools spec:check",
    "unicode:generate": "bun run --cwd tools unicode:generate",
    "unicode:check": "bun run --cwd tools unicode:check",
    "syntax:generate": "bun run --cwd tools syntax:generate",
    "syntax:check": "bun run --cwd tools syntax:check",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --cwd tools syntax:check && bun run --cwd tools unicode:check && bun run --filter '*' test",
    "build": "bun run --cwd tools syntax:check && bun run --cwd tools unicode:check && bun run --cwd impl/ts build",
    "lint": "bunx --bun eslint . --max-warnings 0",
    "lint:fix": "bunx --bun eslint . --fix --max-warnings 0",
    "format": "bunx --bun prettier --write '**/*.{ts,tsx}' eslint.config.js",
    "format:check": "bunx --bun prettier --check '**/*.{ts,tsx}' eslint.config.js",
    "corpus:run": "bun run --cwd impl/ts corpus:run"
  },
  "devDependencies": {
    "@nkzw/eslint-config": "^3.3.0",
    "@types/bun": "^1.4.2",
    "eslint": "^9",
    "prettier": "^3.9.9",
    "typescript": "~6.0.0"
  }
}
