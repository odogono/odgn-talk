{
  "name": "odgn-talk-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "impl/ts",
    "tooling/*",
    "bench/ts",
    "tools"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "changelog": "bun run --cwd tools changelog",
    "release-notes:ts": "bun run --cwd tools release-notes:ts",
    "check": "bun run --cwd tools check",
    "spec:gen": "bun run --cwd tools spec:gen",
    "spec:check": "bun run --cwd tools spec:check",
    "docs:check": "bun run --cwd tools docs:check",
    "unicode:generate": "bun run --cwd tools unicode:generate",
    "unicode:check": "bun run --cwd tools unicode:check",
    "unicode:fetch": "bun run --cwd tools unicode:fetch",
    "go:generate": "bun run --cwd tools go:generate",
    "go:check": "bun run --cwd tools go:check",
    "zig:generate": "bun run --cwd tools zig:generate",
    "zig:check": "bun run --cwd tools zig:check",
    "syntax:generate": "bun run --cwd tools syntax:generate",
    "syntax:check": "bun run --cwd tools syntax:check",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --cwd tools syntax:check && bun run --cwd tools unicode:check && bun run --cwd tools lints:check && bun run --filter '*' test",
    "build": "bun run --cwd tools syntax:check && bun run --cwd tools unicode:check && bun run --cwd tools lints:check && bun run --cwd impl/ts build && bun run --cwd tooling/stack build && bun run --cwd tooling/cli build && bun run --cwd tooling/playground build && bun run --cwd tooling/creative build",
    "lint": "bunx --bun eslint . --max-warnings 0",
    "lint:fix": "bunx --bun eslint . --fix --max-warnings 0",
    "format": "bunx --bun prettier --write '**/*.{ts,tsx}' eslint.config.js",
    "format:check": "bunx --bun prettier --check '**/*.{ts,tsx}' eslint.config.js",
    "corpus:run": "bun run --cwd impl/ts corpus:run",
    "repl": "bun tooling/cli/src/main.ts",
    "bench": "bun bench/ts/src/main.ts",
    "fuzz": "bun tooling/fuzz/src/cli.ts",
    "northtalk": "bun tooling/cli/src/main.ts",
    "playground": "bun run --cwd tooling/playground dev",
    "creative": "bun run --cwd tooling/creative dev",
    "grammar:check": "bun run --cwd tools grammar:check",
    "machine:check": "bun run --cwd tools machine:check",
    "corpus:check": "bun run --cwd tools corpus:check",
    "corpus:bless": "bun tools/corpus/bless.ts",
    "lints:generate": "bun run --cwd tools lints:generate",
    "lints:check": "bun run --cwd tools lints:check",
    "envelope:generate": "bun run --cwd tools envelope:generate",
    "envelope:check": "bun run --cwd tools envelope:check"
  },
  "devDependencies": {
    "@nkzw/eslint-config": "^3.3.0",
    "@types/bun": "^1.4.2",
    "eslint": "^9",
    "prettier": "^3.9.9",
    "typescript": "~6.0.0"
  }
}
